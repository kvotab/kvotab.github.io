{
  "name": "Repository to well, four nuclides",
  "description": "A stylised near-field to biosphere chain: a repository inventory leaks into the geosphere, which discharges to a soil layer, which is leached into a well used for drinking water. Dose is the well concentration times an ingestion rate and a dose coefficient. Illustrative parameter values only. Most parameters carry a distribution, so the model can be run probabilistically; the ICRP dose coefficients are deliberately left fixed.",
  "nuclides": [
    "I-129",
    "Cl-36",
    "Tc-99",
    "Se-79"
  ],
  "simulation": {
    "start_time": 0,
    "end_time": 1000000,
    "output_points": 400,
    "spacing": "log",
    "solver": "ros23",
    "rtol": 1e-06,
    "abstol": 1e-12,
    "time_unit": "year"
  },
  "parameters": [
    {
      "name": "leachRate",
      "values_by_nuclide": {
        "I-129": 1e-05,
        "Cl-36": 2e-05,
        "Tc-99": 4e-06,
        "Se-79": 8e-07
      },
      "default": 1e-06,
      "unit": "1/year",
      "comment": "Release from the waste form, nuclide specific",
      "entries": [
        {
          "index": {
            "Radionuclides": "I-129"
          },
          "pdf": {
            "kind": "logt",
            "params": {
              "min": 1.0000000000000002e-06,
              "max": 0.0001,
              "mode": 1e-05
            },
            "values": null,
            "trmin": null,
            "trmax": null,
            "inorder": true,
            "pos": 0
          }
        },
        {
          "index": {
            "Radionuclides": "Cl-36"
          },
          "pdf": {
            "kind": "logt",
            "params": {
              "min": 2.0000000000000003e-06,
              "max": 0.0002,
              "mode": 2e-05
            },
            "values": null,
            "trmin": null,
            "trmax": null,
            "inorder": true,
            "pos": 0
          }
        },
        {
          "index": {
            "Radionuclides": "Tc-99"
          },
          "pdf": {
            "kind": "logt",
            "params": {
              "min": 4e-07,
              "max": 3.9999999999999996e-05,
              "mode": 4e-06
            },
            "values": null,
            "trmin": null,
            "trmax": null,
            "inorder": true,
            "pos": 0
          }
        },
        {
          "index": {
            "Radionuclides": "Se-79"
          },
          "pdf": {
            "kind": "logt",
            "params": {
              "min": 8e-08,
              "max": 8e-06,
              "mode": 8e-07
            },
            "values": null,
            "trmin": null,
            "trmax": null,
            "inorder": true,
            "pos": 0
          }
        }
      ]
    },
    {
      "name": "geoTransit",
      "per_nuclide": false,
      "value": 0.0002,
      "unit": "1/year",
      "pdf": {
        "kind": "logt",
        "params": {
          "min": 2e-05,
          "max": 0.002,
          "mode": 0.0002
        },
        "values": null,
        "trmin": null,
        "trmax": null,
        "inorder": true,
        "pos": 0
      }
    },
    {
      "name": "soilLeach",
      "per_nuclide": false,
      "value": 0.03,
      "unit": "1/year",
      "pdf": {
        "kind": "logt",
        "params": {
          "min": 0.01,
          "max": 0.1,
          "mode": 0.03
        },
        "values": null,
        "trmin": null,
        "trmax": null,
        "inorder": true,
        "pos": 0
      }
    },
    {
      "name": "Kd",
      "values_by_nuclide": {
        "I-129": 0.001,
        "Cl-36": 0.0005,
        "Tc-99": 0.1,
        "Se-79": 2.0
      },
      "default": 0.01,
      "unit": "m^3/kg",
      "comment": "Sorption in the soil layer; retards leaching",
      "entries": [
        {
          "index": {
            "Radionuclides": "I-129"
          },
          "pdf": {
            "kind": "logt",
            "params": {
              "min": 0.0001,
              "max": 0.01,
              "mode": 0.001
            },
            "values": null,
            "trmin": null,
            "trmax": null,
            "inorder": true,
            "pos": 0
          }
        },
        {
          "index": {
            "Radionuclides": "Cl-36"
          },
          "pdf": {
            "kind": "logt",
            "params": {
              "min": 5e-05,
              "max": 0.005,
              "mode": 0.0005
            },
            "values": null,
            "trmin": null,
            "trmax": null,
            "inorder": true,
            "pos": 0
          }
        },
        {
          "index": {
            "Radionuclides": "Tc-99"
          },
          "pdf": {
            "kind": "logt",
            "params": {
              "min": 0.01,
              "max": 1.0,
              "mode": 0.1
            },
            "values": null,
            "trmin": null,
            "trmax": null,
            "inorder": true,
            "pos": 0
          }
        },
        {
          "index": {
            "Radionuclides": "Se-79"
          },
          "pdf": {
            "kind": "logt",
            "params": {
              "min": 0.2,
              "max": 20.0,
              "mode": 2.0
            },
            "values": null,
            "trmin": null,
            "trmax": null,
            "inorder": true,
            "pos": 0
          }
        }
      ]
    },
    {
      "name": "wellVolume",
      "per_nuclide": false,
      "value": 5000.0,
      "unit": "m^3",
      "pdf": {
        "kind": "triang",
        "params": {
          "min": 3000.0,
          "max": 8000.0,
          "mode": 5000.0
        },
        "values": null,
        "trmin": null,
        "trmax": null,
        "inorder": true,
        "pos": 0
      }
    },
    {
      "name": "wellTurnover",
      "per_nuclide": false,
      "value": 4.0,
      "unit": "1/year",
      "pdf": {
        "kind": "triang",
        "params": {
          "min": 2.0,
          "max": 8.0,
          "mode": 4.0
        },
        "values": null,
        "trmin": null,
        "trmax": null,
        "inorder": true,
        "pos": 0
      }
    },
    {
      "name": "intake",
      "per_nuclide": false,
      "value": 0.6,
      "unit": "m^3/year",
      "comment": "Drinking water",
      "pdf": {
        "kind": "triang",
        "params": {
          "min": 0.4,
          "max": 0.9,
          "mode": 0.6
        },
        "values": null,
        "trmin": null,
        "trmax": null,
        "inorder": true,
        "pos": 0
      }
    },
    {
      "name": "doseCoeff",
      "values_by_nuclide": {
        "I-129": 1.1e-07,
        "Cl-36": 9.3e-10,
        "Tc-99": 6.4e-10,
        "Se-79": 2.9e-09
      },
      "default": 1e-09,
      "unit": "Sv/Bq"
    },
    {
      "name": "rho",
      "per_nuclide": false,
      "value": 1500,
      "unit": "kg/m^3",
      "comment": "Bulk density of the solid, in the retardation factor.",
      "pdf": {
        "kind": "norm",
        "params": {
          "mean": 1500.0,
          "sd": 80.0
        },
        "values": null,
        "trmin": null,
        "trmax": null,
        "inorder": true,
        "pos": 0
      }
    },
    {
      "name": "porosity",
      "per_nuclide": false,
      "value": 0.3,
      "unit": "unitless",
      "comment": "Water-filled porosity, in the retardation factor.",
      "pdf": {
        "kind": "triang",
        "params": {
          "min": 0.2,
          "max": 0.45,
          "mode": 0.3
        },
        "values": null,
        "trmin": null,
        "trmax": null,
        "inorder": true,
        "pos": 0
      }
    }
  ],
  "compartments": [
    {
      "name": "Repository",
      "initial": {
        "I-129": "3.0e12",
        "Cl-36": "2.0e11",
        "Tc-99": "8.0e13",
        "Se-79": "5.0e11"
      },
      "unit": "Bq"
    },
    {
      "name": "Geosphere",
      "initial": "0",
      "unit": "Bq"
    },
    {
      "name": "Soil",
      "initial": "0",
      "unit": "Bq"
    },
    {
      "name": "Well",
      "initial": "0",
      "unit": "Bq"
    }
  ],
  "transfers": [
    {
      "name": "Release",
      "from": "Repository",
      "to": "Geosphere",
      "rate": "leachRate"
    },
    {
      "name": "Migration",
      "from": "Geosphere",
      "to": "Soil",
      "rate": "geoTransit"
    },
    {
      "name": "Leaching",
      "from": "Soil",
      "to": "Well",
      "rate": "soilLeach / (1 + Kd*rho/porosity)"
    },
    {
      "name": "Flushing",
      "from": "Well",
      "to": null,
      "rate": "wellTurnover"
    }
  ],
  "expressions": [
    {
      "name": "WellConc",
      "equation": "Well / wellVolume",
      "unit": "Bq/m^3"
    },
    {
      "name": "Dose",
      "equation": "WellConc * intake * doseCoeff",
      "unit": "Sv/year"
    }
  ],
  "app": {
    "title": "Dose from a leaking repository",
    "description": "Move the controls to see what each does to the dose from the well, and run the spread to see how uncertain it is at those values. The model itself is not changed: every run is of a copy at the values the controls hold.",
    "run": "change",
    "open": "editor",
    "edit_button": true,
    "theme": "standard",
    "realisations": 200,
    "spread_when": "button",
    "pages": [
      {
        "name": "Dose",
        "components": [
          {
            "id": "c1",
            "type": "slider",
            "x": 0,
            "y": 0,
            "w": 4,
            "h": 2,
            "label": "Release from the waste form ×",
            "target": {
              "kind": "value",
              "block": "leachRate",
              "factor": true
            },
            "min": 0.1,
            "max": 10,
            "step": null,
            "scale": "log"
          },
          {
            "id": "c2",
            "type": "slider",
            "x": 0,
            "y": 2,
            "w": 4,
            "h": 2,
            "label": "Transit through the geosphere",
            "target": {
              "kind": "value",
              "block": "geoTransit"
            },
            "min": 0.00002,
            "max": 0.002,
            "step": null,
            "scale": "log"
          },
          {
            "id": "c3",
            "type": "slider",
            "x": 0,
            "y": 4,
            "w": 4,
            "h": 2,
            "label": "Leaching out of the soil",
            "target": {
              "kind": "value",
              "block": "soilLeach"
            },
            "min": 0.01,
            "max": 0.1,
            "step": null,
            "scale": "log"
          },
          {
            "id": "c4",
            "type": "slider",
            "x": 0,
            "y": 6,
            "w": 4,
            "h": 2,
            "label": "Sorption in the soil ×",
            "target": {
              "kind": "value",
              "block": "Kd",
              "factor": true
            },
            "min": 0.1,
            "max": 10,
            "step": null,
            "scale": "log"
          },
          {
            "id": "c5",
            "type": "slider",
            "x": 0,
            "y": 8,
            "w": 4,
            "h": 2,
            "label": "Volume of the well",
            "target": {
              "kind": "value",
              "block": "wellVolume"
            },
            "min": 3000,
            "max": 8000,
            "step": null,
            "scale": "linear"
          },
          {
            "id": "c6",
            "type": "chart",
            "x": 4,
            "y": 0,
            "w": 8,
            "h": 10,
            "title": "Dose to somebody drinking from the well",
            "series": [
              {
                "block": "Dose"
              }
            ],
            "x_scale": "log",
            "y_scale": "log",
            "legend": true,
            "spread": "bands",
            "mean": false
          },
          {
            "id": "c13",
            "type": "button",
            "x": 0,
            "y": 10,
            "w": 4,
            "h": 1,
            "label": "Run the spread",
            "action": "sample"
          },
          {
            "id": "c7",
            "type": "value",
            "x": 0,
            "y": 11,
            "w": 4,
            "h": 2,
            "title": "Peak dose, I-129",
            "series": [
              {
                "block": "Dose",
                "index": {
                  "Radionuclides": "I-129"
                }
              }
            ],
            "statistic": "max",
            "at": null,
            "digits": 3,
            "limit": 0.0001,
            "curve": "run"
          },
          {
            "id": "c8",
            "type": "value",
            "x": 0,
            "y": 13,
            "w": 4,
            "h": 2,
            "title": "When the I-129 dose peaks",
            "series": [
              {
                "block": "Dose",
                "index": {
                  "Radionuclides": "I-129"
                }
              }
            ],
            "statistic": "max_time",
            "at": null,
            "digits": 3,
            "limit": null,
            "curve": "run"
          },
          {
            "id": "c9",
            "type": "bars",
            "x": 4,
            "y": 10,
            "w": 8,
            "h": 7,
            "title": "Peak dose of each radionuclide",
            "series": [
              {
                "block": "Dose"
              }
            ],
            "statistic": "max",
            "at": null,
            "scale": "log",
            "sort": true,
            "curve": "run"
          },
          {
            "id": "c14",
            "type": "value",
            "x": 0,
            "y": 15,
            "w": 4,
            "h": 2,
            "title": "Peak dose, I-129, 95th percentile",
            "series": [
              {
                "block": "Dose",
                "index": {
                  "Radionuclides": "I-129"
                }
              }
            ],
            "statistic": "max",
            "at": null,
            "digits": 3,
            "limit": 0.0001,
            "curve": "p95"
          }
        ]
      },
      {
        "name": "Inventories",
        "components": [
          {
