            "x": 0,
            "y": 0,
            "w": 8,
            "h": 11,
            "tabs": [
              {
                "name": "Where the I-129 is",
                "components": [
                  {
                    "id": "c10",
                    "type": "chart",
                    "x": 0,
                    "y": 0,
                    "w": 12,
                    "h": 10,
                    "title": "Where the I-129 is",
                    "series": [
                      {
                        "block": "Repository",
                        "index": {
                          "Radionuclides": "I-129"
                        }
                      },
                      {
                        "block": "Geosphere",
                        "index": {
                          "Radionuclides": "I-129"
                        }
                      },
                      {
                        "block": "Soil",
                        "index": {
                          "Radionuclides": "I-129"
                        }
                      },
                      {
                        "block": "Well",
