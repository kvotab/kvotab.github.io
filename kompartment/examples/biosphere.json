      "name": "doseCoeff",
      "values_by_nuclide": {
        "I-129": 1.1e-07,
        "Cl-36": 9.3e-10,
        "Tc-99": 6.4e-10,
        "Se-79": 2.9e-09
      },
      "default": 1e-09,
      "unit": "Sv/Bq"
    },
    {
      "name": "rho",
      "per_nuclide": false,
      "value": 1500,
      "unit": "kg/m^3",
      "comment": "Bulk density of the solid, in the retardation factor.",
      "pdf": {
        "kind": "norm",
        "params": {
          "mean": 1500.0,
          "sd": 80.0
        },
        "values": null,
        "trmin": null,
        "trmax": null,
        "inorder": true,
        "pos": 0
      }
    },
    {
      "name": "porosity",
      "per_nuclide": false,
      "value": 0.3,
      "unit": "unitless",
      "comment": "Water-filled porosity, in the retardation factor.",
      "pdf": {
        "kind": "triang",
        "params": {
          "min": 0.2,
          "max": 0.45,
          "mode": 0.3
        },
        "values": null,
        "trmin": null,
        "trmax": null,
        "inorder": true,
        "pos": 0
      }
    }
  ],
  "compartments": [
    {
      "name": "Repository",
      "initial": {
        "I-129": "3.0e12",
        "Cl-36": "2.0e11",
        "Tc-99": "8.0e13",
        "Se-79": "5.0e11"
      },
      "unit": "Bq"
    },
    {
      "name": "Geosphere",
      "initial": "0",
      "unit": "Bq"
    },
    {
      "name": "Soil",
      "initial": "0",
      "unit": "Bq"
    },
    {
      "name": "Well",
      "initial": "0",
      "unit": "Bq"
    }
  ],
  "transfers": [
    {
      "name": "Release",
      "from": "Repository",
      "to": "Geosphere",
      "rate": "leachRate"
    },
    {
      "name": "Migration",
      "from": "Geosphere",
      "to": "Soil",
      "rate": "geoTransit"
    },
    {
      "name": "Leaching",
      "from": "Soil",
      "to": "Well",
      "rate": "soilLeach / (1 + Kd*rho/porosity)"
    },
    {
      "name": "Flushing",
      "from": "Well",
      "to": null,
      "rate": "wellTurnover"
    }
  ],
  "expressions": [
    {
      "name": "WellConc",
      "equation": "Well / wellVolume",
      "unit": "Bq/m^3"
    },
    {
      "name": "Dose",
      "equation": "WellConc * intake * doseCoeff",
      "unit": "Sv/year"
    }
  ]
}
