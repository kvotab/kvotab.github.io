      "unit": "Sv/year per Bq/m3",
      "per_nuclide": false
    },
    {
      "name": "depth",
      "value": 2.0,
      "unit": "m",
      "comment": "Mean depth of the lake: area times this is its volume."
    },
    {
      "name": "V_lake",
      "value": 10000.0,
      "unit": "m3",
      "comment": "Lake volume, so the groundwater flow becomes a turnover rate."
    }
