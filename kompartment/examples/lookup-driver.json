{
  "name": "A time-dependent driver",
  "description": "Two lookup tables drive the model: the groundwater flow through a biosphere object over a glacial cycle, and the lake area as the basin silts up. Both are read at the simulation clock, which is what makes a lookup table a time-dependent parameter rather than a constant. The advective transfer follows Q_gw / V, so its rate -- and the Jacobian -- move with time; the dose expression divides by the lake area, which is what the table is there to say.",
  "simulation": {
    "start_time": 0,
    "end_time": 20000,
    "output_points": 300,
    "spacing": "linear",
    "solver": "ndf",
    "rtol": 1e-06,
    "abstol": 1e-09,
    "time_unit": "year"
  },
  "nuclides": [
    "I-129"
  ],
  "parameters": [
