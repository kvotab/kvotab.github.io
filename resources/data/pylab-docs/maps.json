lse,"hit":true,"cmenu":null,"x":{"$":"","shape":[1,103],"dt":"f4"},"y":{"$":"","shape":[1,103],"dt":"f4"},"z":null,"color":[1.0,0.0,0.0],"lineStyle":"none","lineWidth":0.5,"marker":".","markerSize":6.0,"mfc":"none","mec":"auto"},{"id":10,"type":"line","visible":true,"displayName":"","clip":true,"bdf":false,"hit":true,"cmenu":null,"x":{"$":"","shape":[1,197],"dt":"f4"},"y":{"$":"","shape":[1,197],"dt":"f4"},"z":null,"color":[0.0,0.0,1.0],"lineStyle":"none","lineWidth":0.5,"marker":".","markerSize":6.0,"mfc":"none","mec":"auto"}],"xtickformat":null,"ytickformat":null,"ztickformat":null,"ztickrot":0.0,"polar":null,"texts":[],"yy":null,"units":"normalized","fontUnits":"points","parent":null,"bdf":false,"hit":true,"cmenu":null}],"legends":[],"colorbars":[],"annotations":[],"sgtitle":null,"cmap":{"$ref":"parula"},"menuBar":"figure","toolBar":"auto","pointer":"arrow","resize":true,"dialog":false,"placed":false,"closeDefault":true,"flags":{"wbdf":false,"wbuf":false,"wbmf":false,"scroll":false,"kpf":false,"krf":false,"wkpf":false,"wkrf":false,"bdf":false,"size":false,"resize":false},"cmenu":null,"menus":[],"toolbars":[],"controls":[],"cmenus":[]}]}],"notes":[],"see":["polyarea","isinterior"]},{"names":["polyarea"],"summary":"The area of a polygon in the plane.","body":["By the shoelace formula, half the sum of the cross products of successive vertices; the vertices go round in either direction, and the polygon closes itself."],"syntax":[["a = polyarea(x, y)","The area."]],"inputs":[],"outputs":[],"examples":[{"title":"A triangle and a regular hexagon","intro":"","code":"polyarea([0 4 0], [0 0 3])\nt = (0:5)*pi/3;\n[polyarea(cos(t), sin(t)) 3*sqrt(3)/2]","after":"","output":"ans =\n\n     6\n\nans =\n\n    2.5981    2.5981","figures":[]}],"notes":[],"see":["areaint","inpolygon"]},{"names":["ispolycw","poly2cw","poly2ccw"],"summary":"Whether a polygon's parts run clockwise, and its parts made to run one way.","body":["Outer boundaries and holes are often told apart by direction (shapefiles want outer rings clockwise and holes counterclockwise). Parts are separated by NaN and each is tested or turned on its own."],"syntax":[["tf = ispolycw(x, y)","For each part, whether it runs clockwise."],["[x, y] = poly2cw(x, y)","Clockwise."],["[x, y] = poly2ccw(x, y)","Counterclockwise."]],"inputs":[],"outputs":[],"examples":[{"title":"A square turned","intro":"","code":"x = [0 1 1 0 0];\ny = [0 0 1 1 0];\nispolycw(x, y)\n[xc, yc] = poly2cw(x, y);\nispolycw(xc, yc)\nxc","after":"","output":"ans =\n\n  logical\n\n   0\n\nans =\n\n  logical\n\n   1\n\nxc =\n\n     0     0     1     1     0","figures":[]}],"notes":[],"see":["polysplit","polyarea"]},{"names":["polysplit","polyjoin"],"summary":"The NaN-separated parts of a polygon or line as cells, and cells joined back.","body":["Map data keep several parts in one vector, NaN between them; `polysplit` gives a cell for each part (a column each), and `polyjoin` makes one column of them again."],"syntax":[["[xc, yc] = polysplit(x, y)","The parts as cells."],["[x, y] = polyjoin(xc, yc)","One vector, NaN between the parts."]],"inputs":[],"outputs":[],"examples":[{"title":"Two parts and back","intro":"","code":"x = [0 1 1 NaN 3 4];\ny = [0 0 1 NaN 3 3];\n[xc, yc] = polysplit(x, y)\n[x2, y2] = polyjoin(xc, yc);\nisequaln(x2, x(:))","after":"","output":"xc = \n\n  2×1 cell array\n\n    {3×1 double}\n    {2×1 double}\n\nyc = \n\n  2×1 cell array\n\n    {3×1 double}\n    {2×1 double}\n\nans =\n\n  logical\n\n   1","figures":[]}],"notes":[],"see":["ispolycw"]},{"names":["polyxpoly"],"summary":"Where two polylines cross.","body":["The intersection points of two lines (or polygon boundaries) in the plane; `ii` gives, for each, the segments of the first and the second line that cross there."],"syntax":[["[xi, yi] = polyxpoly(x1, y1, x2, y2)","The crossings."],["[xi, yi, ii] = polyxpoly(x1, y1, x2, y2)","With the segments."]],"inputs":[],"outputs":[],"examples":[{"title":"A sine wave crossing a line","intro":"","code":"x = linspace(0, 10, 200);\ny = sin(x);\n[xi, yi] = polyxpoly(x, y, [0 10], [-0.2 0.6]);\nxi'\nplot(x, y, [0 10], [-0.2 0.6], xi, yi, 'ko')","after":"","output":"ans =\n\n    3.0940    6.6191    8.8883","figures":[{"id":1,"type":"figure","number":1,"name":"","numberTitle":true,"width":560.0,"height":420.0,"color":[0.94,0.94,0.94],"visible":true,"version":4,"windowStyle":"normal","axes":[{"id":2,"type":"axes","kind":"cartesian","geo":false,"position":[0.13,0.11,0.775,0.815],"xlim":[0.0,10.0],"ylim":[-1.0,1.0],"zlim":[0.0,1.0],"xlimMode":"auto","ylimMode":"auto","zlimMode":"auto","clim":[0.0,1.0],"tight":{"X":false,"Y":false,"Z":false},"xscale":"linear","yscale":"linear","zscale":"linear","xdir":"normal","ydir":"normal","zdir":"normal","xgrid":false,"ygrid":false,"zgrid":false,"xminorgrid":false,"yminorgrid":false,"zminorgrid":false,"box":true,"color":[1.0,1.0,1.0],"xcolor":[0.15,0.15,0.15],"ycolor":[0.15,0.15,0.15],"zcolor":[0.15,0.15,0.15],"gridColor":[0.15,0.15,0.15],"gridAlpha":0.15,"gridLineStyle":"-","fontSize":10.0,"lineWidth":0.5,"tickDir":"in","view":[0.0,90.0],"camTarget":null,"camUp":null,"xkind":null,"ykind":null,"zkind":null,"xtick":null,"ytick":null,"ztick":null,"xticklabel":null,"yticklabel":null,"zticklabel":null,"xtickrot":0.0,"ytickrot":0.0,"xaxisLocation":"bottom","yaxisLocation":"left","dar":[1.0,1.0,1.0],"darMode":"auto","pbar":[1.0,1.0,1.0],"pbarMode":"auto","camZoom":1.0,"visible":true,"layer":"bottom","fontName":"Helvetica","fontWeight":"normal","tickLabelInterpreter":"tex","tickLength":[0.01,0.025],"xminortick":false,"yminortick":false,"zminortick":false,"minorGridAlpha":0.25,"minorGridLineStyle":":","titleSize":1.1,"labelSize":1.1,"title":{"id":3,"string":"","fontSize":10.0,"fontUnits":"points","fontWeight":"bold","fontAngle":"normal","color":[0.0,0.0,0.0],"rotation":0.0,"interpreter":"tex","visible":true,"halign":"left","valign":"middle","position":[0.0,0.0,0.0],"units":"data","background":"none","edge":"none","fontName":"Helvetica","margin"