fontName":"Helvetica","margin":3.0,"lineWidth":0.5,"lineStyle":"-"},"ylabel":{"id":5,"string":"","fontSize":10.0,"fontUnits":"points","fontWeight":"normal","fontAngle":"normal","color":[0.0,0.0,0.0],"rotation":90.0,"interpreter":"tex","visible":true,"halign":"left","valign":"middle","position":[0.0,0.0,0.0],"units":"data","background":"none","edge":"none","fontName":"Helvetica","margin":3.0,"lineWidth":0.5,"lineStyle":"-"},"zlabel":{"id":6,"string":"","fontSize":10.0,"fontUnits":"points","fontWeight":"normal","fontAngle":"normal","color":[0.0,0.0,0.0],"rotation":90.0,"interpreter":"tex","visible":true,"halign":"left","valign":"middle","position":[0.0,0.0,0.0],"units":"data","background":"none","edge":"none","fontName":"Helvetica","margin":3.0,"lineWidth":0.5,"lineStyle":"-"},"cmap":{"$ref":"parula"},"children":[{"id":8,"type":"line","visible":true,"displayName":"e^{-t}","clip":true,"bdf":false,"hit":true,"cmenu":null,"x":{"$":"","shape":[1,100],"dt":"f4"},"y":{"$":"","shape":[1,100],"dt":"f4"},"z":null,"color":[0.0,0.447,0.741],"lineStyle":"-","lineWidth":0.5,"marker":"none","markerSize":6.0,"mfc":"none","mec":"auto"},{"id":9,"type":"line","visible":true,"displayName":"e^{-t/2}","clip":true,"bdf":false,"hit":true,"cmenu":null,"x":{"$":"","shape":[1,100],"dt":"f4"},"y":{"$":"","shape":[1,100],"dt":"f4"},"z":null,"color":[0.85,0.325,0.098],"lineStyle":"-","lineWidth":0.5,"marker":"none","markerSize":6.0,"mfc":"none","mec":"auto"}],"xtickformat":null,"ytickformat":null,"ztickformat":null,"ztickrot":0.0,"polar":null,"texts":[],"yy":null,"units":"normalized","fontUnits":"points","parent":null,"bdf":false,"hit":true,"cmenu":null}],"legends":[{"id":10,"axes":2,"location":"northeast","orientation":"vertical","box":true,"fontSize":9.0,"visible":true,"textColor":[0.0,0.0,0.0],"color":[1.0,1.0,1.0],"edgeColor":[0.15,0.15,0.15],"numColumns":1,"title":"","entries":[{"id":8,"name":"e^{-t}","type":"line","color":[0.0,0.447,0.741],"lineStyle":"-","lineWidth":0.5,"marker":"none","markerSize":6.0,"markerFaceColor":"none","markerEdgeColor":"auto"},{"id":9,"name":"e^{-t/2}","type":"line","color":[0.85,0.325,0.098],"lineStyle":"-","lineWidth":0.5,"marker":"none","markerSize":6.0,"markerFaceColor":"none","markerEdgeColor":"auto"}],"interpreter":"tex"}],"colorbars":[],"annotations":[],"sgtitle":null,"cmap":{"$ref":"parula"},"menuBar":"figure","toolBar":"auto","pointer":"arrow","resize":true,"dialog":false,"placed":false,"closeDefault":true,"flags":{"wbdf":false,"wbuf":false,"wbmf":false,"scroll":false,"kpf":false,"krf":false,"wkpf":false,"wkrf":false,"bdf":false,"size":false,"resize":false},"cmenu":null,"menus":[],"toolbars":[],"controls":[],"cmenus":[]}]},{"title":"A point on the unit circle","intro":"","code":"z = exp(1i*pi/3)\nabs(z)","after":"","output":"z =\n\n   0.5000 + 0.8660i\n\nans =\n\n     1","figures":[]}],"notes":[],"see":["log","expm","power"]},{"names":["log"],"summary":"The natural logarithm (complex for negative numbers).","body":["The inverse of `exp`: `log(exp(x))` is `x`. Works element by element; `log(0)` is `-Inf`, and the logarithm of a negative number is complex, with imaginary part pi. For other bases use `log10`, `log2`, or `log(x)/log(b)`."],"syntax":[["y = log(x)","The natural logarithm of each element."]],"inputs":[],"outputs":[],"examples":[{"title":"Logarithms of some numbers","intro":"","code":"log([1 exp(1) 10])\nlog(0)\nlog(-1)","after":"","output":"ans =\n\n         0    1.0000    2.3026\n\nans =\n\n  -Inf\n\nans =\n\n   0.0000 + 3.1416i","figures":[]},{"title":"The logarithm in another base","intro":"","code":"b = 3;\nlog(81) / log(b)","after":"","output":"ans =\n\n     4","figures":[]}],"notes":[],"see":["exp","log10","log2","log1p"]},{"names":["log10"],"summary":"The base 10 logarithm.","body":["`log10(1000)` is 3. Useful for orders of magnitude and decibels: a power ratio `r` is `10*log10(r)` decibels."],"syntax":[["y = log10(x)","The base 10 logarithm of each element."]],"inputs":[],"outputs":[],"examples":[{"title":"Orders of magnitude","intro":"","code":"log10([1 10 1000 0.01])","after":"","output":"ans =\n\n     0     1     3    -2","figures":[]},{"title":"Decibels","intro":"","code":"ratio = [1 2 10 100];\ndB = 10*log10(ratio)","after":"","output":"dB =\n\n         0    3.0103   10.0000   20.0000","figures":[]}],"notes":[],"see":["log","log2","semilogy","loglog"]},{"names":["abs"],"summary":"The absolute value; the modulus of a complex number.","body":["Of a real number its size without the sign; of a complex number its distance from 0, `sqrt(real(z)^2 + imag(z)^2)`. Works element by element."],"syntax":[["y = abs(x)","The absolute value of each element."]],"inputs":[],"outputs":[],"examples":[{"title":"Real and complex numbers","intro":"","code":"abs([-3 0 2.5])\nabs(3 + 4i)","after":"","output":"ans =\n\n    3.0000         0    2.5000\n\nans =\n\n     5","figures":[]},{"title":"The largest deviation from a value","intro":"","code":"v = [9.8 10.4 9.1 10.2];\nmaxDev = max(abs(v - 10))","after":"","output":"maxDev =\n\n    0.9000","figures":[]}],"notes":[],"see":["sign","angle","norm"]},{"names":["round"],"summary":"Round to the nearest integer (halves away from zero), or to a number of digits.","body":["A half is rounded away from zero: `round(2.5)` is 3 and `round(-2.5)` is -3. With `n`, it rounds to `n` digits after the decimal point (or before it, for negative `n`), or to `n` significant digits with `'significant'`."],"syntax":[["y = round(x)","The nearest integer to each element."],["y = round(x, n)","To `n` decimal places (to tens, hundreds, … for negative `n`)."],["y = round(x, n, 'significant')","To `n` significant digits."]],"inputs":[],"outputs":[],"examples":[{"title":"Halves go away from zero","intro":"","code":"round([2.5 -2.5 1.4 -1.6])","after":"","output":"ans =\n\n     3    -3     1    -2","figures":[]},{"title":"Decimal places, tens and hundreds, and significant digits","intro":"","code":"round(pi, 2)\nround(1234.5678, -2)\nround(98765, 2, 'significant')","after":"","output":"ans =\n\n    3.1400\n\nans =\n\n        1200\n\nans =\n\n       99000","figures":[]}],"notes":[],"see":["floor","ceil","fix"]},{"names":["floor","ceil","fix"],"summary":"Round toward minus infinity, plus infinity or zero.","body":["`floor` gives the largest integer not above each value, `ceil` the smallest not below it, and `fix` drops the fraction (toward zero). They differ only for negative numbers and fractions: `floor(-2.5)` is -3 while `fix(-2.5)` is -2."],"syntax":[["y = floor(x)","Toward minus infinity."],["y = ceil(x)","Toward plus infinity."],["y = fix(x)","Toward zero."]],"inputs":[],"outputs":[],"examples":[{"title":"The three side by side","intro":"","code":"x = [-2.5 -1.2 1.2 2.5];\n[floor(x); ceil(x); fix(x)]","after":"","output":"ans =\n\n    -3    -2     1     2\n    -2    -1     2     3\n    -2    -1     1     2","figures":[]},{"title":"Whole hours and minutes","intro":"","code":"minutes = 135;\nhours = floor(minutes/60)\nrest = minutes - 60*hours","after":"","output":"hours =\n\n     2\n\nrest =\n\n    15","figures":[]},{"title":"How many boxes of 12 hold 50 things","intro":"","code":"boxes = ceil(50/12)","after":"","output":"boxes =\n\n     5","figures":[]}],"notes":[],"see":["round","mod","rem","idivide"]},{"names":["mod","rem"],"summary":"The remainder after division.","body":["Both give `a - q.*b` for a whole number `q`; they differ in which way `q` is rounded. `mod` rounds down (`floor`), so its result has the sign of `b`; `rem` rounds toward zero (`fix`), so its result has the sign of `a`. For positive numbers they agree. `mod(a, 0)` is `a`."],"syntax":[["r = mod(a, b)","`a - floor(a./b).*b`: the remainder with the sign of the divisor."],["r = rem(a, b)","`a - fix(a./b).*b`: the remainder with the sign of the dividend."]],"inputs":[],"outputs":[],"examples":[{"title":"The same for positive numbers, different for negative ones","intro":"","code":"a = [7 -7 7 -7];\nb = [3 3 -3 -3];\n[mod(a, b); rem(a, b)]","after":"","output":"ans =\n\n     1     2    -2    -1\n     1    -1     1    -1","figures":[]},{"title":"Even and odd, and wrapping round","intro":"","code":"n = 1:6;\nisEven = mod(n, 2) == 0\nhour = mod(22 + 5, 24)","after":"","output":"isEven =\n\n  1×6 logical array\n\n   0   1   0   1   0   1\n\nhour =\n\n     3","figures":[]},{"title":"Angles brought into [0, 360)","intro":"","code":"mod([370 -30 720], 360)","after":"","output":"ans =\n\n    10   330     0","figures":[]}],"notes":[],"see":["floor","fix","idivide"]},{"names":["sin","cos","tan"],"summary":"The sine, cosine and tangent of angles in radians.","body":["Each works element by element. For angles in degrees use `sind`, `cosd` and `tand`, or convert with `deg2rad`. The inverses are `asin`, `acos`, `atan` and, for a full turn of angles, `atan2`."],"syntax":[["y = sin(x)","The sine of each element."],["y = cos(x)","The cosine of each element."],["y = tan(x)","The tangent of each element."]],"inputs":[],"outputs":[],"examples":[{"title":"Some angles","intro":"","code":"x = [0 pi/6 pi/4 pi/2];\ns = sin(x)\nc = cos(x)","after":"","output":"s =\n\n         0    0.5000    0.7071    1.0000\n\nc =\n\n    1.0000    0.8660    0.7071    0.0000","figures":[]},{"title":"The three curves","intro":"","code":"x = linspace(-pi, pi, 200);\nplot(x, sin(x), x, cos(x))\nhold on\nplot(x, tan(x), ':')\nhold off\nylim([-2 2])\nlegend('sin', 'cos', 'tan')\ngrid on","after":"","output":"","figures":[{"id":1,"type":"figure","number":1,"name":"","numberTitle":true,"width":560.0,"height":420.0,"color":[0.94,0.94,0.94],"visible":true,"version":9,"windowStyle":"normal","axes":[{"id":2,"type":"axes","kind":"cartesian","geo":false,"position":[0.13,0.11,0.775,0.815],"xlim":[-4.0,4.0],"ylim":[-2.0,2.0],"zlim":[0.0,1.0],"xlimMode":"auto","ylimMode":"manual","zlimMode":"auto","clim":[0.0,1.0],"tight":{"X":false,"Y":false,"Z":false},"xscale":"linear","yscale":"linear","zscale":"linear","xdir":"normal","ydir":"normal","zdir":"normal","xgrid":true,"ygr