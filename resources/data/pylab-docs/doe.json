Length":[0.01,0.025],"xminortick":false,"yminortick":false,"zminortick":false,"minorGridAlpha":0.25,"minorGridLineStyle":":","titleSize":1.1,"labelSize":1.1,"title":{"id":10,"string":"central composite","fontSize":10.0,"fontUnits":"points","fontWeight":"bold","fontAngle":"normal","color":[0.0,0.0,0.0],"rotation":0.0,"interpreter":"tex","visible":true,"halign":"left","valign":"middle","position":[0.0,0.0,0.0],"units":"data","background":"none","edge":"none","fontName":"Helvetica","margin":3.0,"lineWidth":0.5,"lineStyle":"-"},"subtitle":{"id":14,"string":"","fontSize":10.0,"fontUnits":"points","fontWeight":"normal","fontAngle":"normal","color":[0.0,0.0,0.0],"rotation":0.0,"interpreter":"tex","visible":true,"halign":"left","valign":"middle","position":[0.0,0.0,0.0],"units":"data","background":"none","edge":"none","fontName":"Helvetica","margin":3.0,"lineWidth":0.5,"lineStyle":"-"},"xlabel":{"id":11,"string":"","fontSize":10.0,"fontUnits":"points","fontWeight":"normal","fontAngle":"normal","color":[0.0,0.0,0.0],"rotation":0.0,"interpreter":"tex","visible":true,"halign":"left","valign":"middle","position":[0.0,0.0,0.0],"units":"data","background":"none","edge":"none","fontName":"Helvetica","margin":3.0,"lineWidth":0.5,"lineStyle":"-"},"ylabel":{"id":12,"string":"","fontSize":10.0,"fontUnits":"points","fontWeight":"normal","fontAngle":"normal","color":[0.0,0.0,0.0],"rotation":90.0,"interpreter":"tex","visible":true,"halign":"left","valign":"middle","position":[0.0,0.0,0.0],"units":"data","background":"none","edge":"none","fontName":"Helvetica","margin":3.0,"lineWidth":0.5,"lineStyle":"-"},"zlabel":{"id":13,"string":"","fontSize":10.0,"fontUnits":"points","fontWeight":"normal","fontAngle":"normal","color":[0.0,0.0,0.0],"rotation":90.0,"interpreter":"tex","visible":true,"halign":"left","valign":"middle","position":[0.0,0.0,0.0],"units":"data","background":"none","edge":"none","fontName":"Helvetica","margin":3.0,"lineWidth":0.5,"lineStyle":"-"},"cmap":{"$ref":"parula"},"children":[{"id":15,"type":"line","visible":true,"displayName":"","clip":true,"bdf":false,"hit":true,"cmenu":null,"x":{"$":"AACAvwAAgL8AAIC/AACAvwAAgD8AAIA/AACAPwAAgD/9RNe//UTXPwAAAAAAAAAAAAAAAAAAAAAAAAAA","shape":[1,15],"dt":"f4"},"y":{"$":"AACAvwAAgL8AAIA/AACAPwAAgL8AAIC/AACAPwAAgD8AAAAAAAAAAP1E17/9RNc/AAAAAAAAAAAAAAAA","shape":[1,15],"dt":"f4"},"z":{"$":"AACAvwAAgD8AAIC/AACAPwAAgL8AAIA/AACAvwAAgD8AAAAAAAAAAAAAAAAAAAAA/UTXv/1E1z8AAAAA","shape":[1,15],"dt":"f4"},"color":[0.0,0.447,0.741],"lineStyle":"none","lineWidth":0.5,"marker":"o","markerSize":6.0,"mfc":"none","mec":"auto"}],"xtickformat":null,"ytickformat":null,"ztickformat":null,"ztickrot":0.0,"polar":null,"texts":[],"yy":null,"units":"normalized","fontUnits":"points","parent":null,"bdf":false,"hit":true,"cmenu":null}],"legends":[],"colorbars":[],"annotations":[],"sgtitle":null,"cmap":{"$ref":"parula"},"menuBar":"figure","toolBar":"auto","pointer":"arrow","resize":true,"dialog":false,"placed":false,"closeDefault":true,"flags":{"wbdf":false,"wbuf":false,"wbmf":false,"scroll":false,"kpf":false,"krf":false,"wkpf":false,"wkrf":false,"bdf":false,"size":false,"resize":false},"cmenu":null,"menus":[],"toolbars":[],"controls":[],"cmenus":[]}]}],"notes":[],"see":["fullfact","fitlm"]},{"names":["candgen","candexch","rowexch","cordexch"],"summary":"D-optimal designs: the runs that estimate a model's coefficients best.","body":["A D-optimal design makes det(X'X) as large as it can for its number of runs, X the model matrix, so that the coefficients' joint confidence region is smallest. `candgen` lists a candidate grid (-1 and 1, and 0 for quadratic models); `candexch` picks rows of a candidate model matrix by exchanging one at a time from random starts; `rowexch` does both for a model (`'linear'`, `'interaction'`, `'quadratic'` or `'purequadratic'`); `cordexch` changes one coordinate at a time instead, without a candidate list."],"syntax":[["dC = candgen(nfactors, model)","The candidates."],["rlist = candexch(C, nruns, 'tries', k)","Rows chosen."],["[dRE, X] = rowexch(nfactors, nruns, model)","By row exchange."],["[dCE, X] = cordexch(nfactors, nruns, model, 'tries', k)","By coordinate exchange."]],"inputs":[],"outputs":[],"examples":[{"title":"Nine runs for a quadratic model in two factors","intro":"","code":"[d, X] = cordexch(2, 9, 'quadratic', 'tries', 5);\nsortrows(d)\nround(det(X'*X))\n[d2, X2] = rowexch(2, 9, 'quadratic');\nround(det(X2'*X2))","after":"","output":"ans =\n\n    -1    -1\n    -1     0\n    -1     1\n     0    -1\n     0     0\n     0     1\n     1    -1\n     1     0\n     1     1\n\nans =\n\n        5184\n\nans =\n\n        5184","figures":[]}],"notes":[],"see":["daugment","fitlm"]},{"names":["daugment","dcovary"],"summary":"D-optimal designs extended by more runs, and around covariates fixed in advance.","body":["`daugment` adds runs to an existing design, chosen so that the whole design is D-optimal for the model; `dcovary` chooses the factors for runs whose covariates are already fixed (a block, a day, a measured property), the covariates coming after the factors in the result."],"syntax":[["[dCE2, X] = daugment(startdes, nruns, model)","Augmented."],["[dCV, X] = dcovary(nfactors, covariates, model)","Around covariates."]],"inputs":[],"outputs":[],"examples":[{"title":"Four runs made eight, and a design over two days","intro":"","code":"start = [-1 -1; 1 1; -1 1; 1 -1];\nd = daugment(start, 4, 'interaction');\nsize(d)\nisequal(d(1:4, :), start)\ndays = [zeros(4, 1); ones(4, 1)];\ndc = dcovary(2, days, 'linear');\ndc(:, end)'","after":"","output":"ans =\n\n     8     2\n\nans =\n\n  logical\n\n   1\n\nans =\n\n     0     0     0     0     1     1     1     1","figures":[]}],"notes":[],"see":["cordexch"]}]}
