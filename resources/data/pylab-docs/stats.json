"clip":true,"bdf":false,"hit":true,"cmenu":null,"x":{"$":"","shape":[1,100],"dt":"f4"},"y":{"$":"","shape":[1,100],"dt":"f4"},"z":null,"color":[0.85,0.325,0.098],"lineStyle":"-","lineWidth":2.0,"marker":"none","markerSize":6.0,"mfc":"none","mec":"auto"}],"xtickformat":null,"ytickformat":null,"ztickformat":null,"ztickrot":0.0,"polar":null,"texts":[],"yy":null,"units":"normalized","fontUnits":"points","parent":null,"bdf":false,"hit":true,"cmenu":null}],"legends":[],"colorbars":[],"annotations":[],"sgtitle":null,"cmap":{"$ref":"parula"},"menuBar":"figure","toolBar":"auto","pointer":"arrow","resize":true,"dialog":false,"placed":false,"closeDefault":true,"flags":{"wbdf":false,"wbuf":false,"wbmf":false,"scroll":false,"kpf":false,"krf":false,"wkpf":false,"wkrf":false,"bdf":false,"size":false,"resize":false},"cmenu":null,"menus":[],"toolbars":[],"controls":[],"cmenus":[]}]},{"title":"The bandwidth used","intro":"","code":"rng default\n[~, ~, bw] = ksdensity(randn(1, 500))","after":"","output":"bw =\n\n    0.3007","figures":[]}],"notes":[],"see":["histogram","ecdf","fitdist"]},{"names":["corr"],"summary":"Correlations between the columns of matrices, with p-values.","body":["Pearson's linear correlation by default; Spearman's (of ranks) and Kendall's tau measure any monotone relation. The p-values test the hypothesis of no correlation. With two matrices, every column of the first is paired with every column of the second. `'Rows', 'pairwise'` uses for each pair the rows where both are present."],"syntax":[["rho = corr(X)","The correlations between the columns of `X`."],["rho = corr(X, Y)","Between the columns of `X` and those of `Y`."],["[rho, p] = corr(..., 'Type', 'Pearson' | 'Spearman' | 'Kendall', 'Rows', 'all' | 'complete' | 'pairwise')","Another kind, rows with missing values handled, and p-values."]],"inputs":[],"outputs":[],"examples":[{"title":"A curved relation: linear and rank correlation","intro":"","code":"x = (1:10)';\ny = exp(x / 2);\n[corr(x, y) corr(x, y, 'Type', 'Spearman')]","after":"","output":"ans =\n\n    0.8654    1.0000","figures":[]},{"title":"With p-values","intro":"","code":"rng default\na = randn(30, 1);\nb = a + randn(30, 1);\n[r, p] = corr(a, b)","after":"","output":"r =\n\n    0.7419\n\np =\n\n   2.7002e-06","figures":[]}],"notes":[],"see":["corrcoef","cov","partialcorr"]},{"names":["bootstrp","jackknife"],"summary":"A statistic of samples drawn from the data with replacement, or of the data with each observation left out.","body":["`bootstrp` draws `nboot` samples of the data's size with replacement and computes the statistic of each: their spread estimates the statistic's standard error, and their quantiles a confidence interval. `jackknife` computes it with each observation left out in turn. Several data arrays are sampled by the same rows."],"syntax":[["stats = bootstrp(nboot, @fun, data)","`fun` of `nboot` resamples, a row each."],["stats = bootstrp(nboot, @fun, data1, data2, ...)","Of several arrays sampled by the same rows."],["[stats, samples] = bootstrp(...)","With the indices drawn."],["stats = jackknife(@fun, data)","`fun` of the data without each row in turn."]],"inputs":[],"outputs":[],"examples":[{"title":"The standard error of a median","intro":"","code":"rng default\nx = exprnd(2, 50, 1);\nm = bootstrp(1000, @median, x);\n[median(x) std(m)]\nprctile(m, [2.5 97.5])","after":"","output":"ans =\n\n    2.1320    0.4087\n\nans =\n\n    1.1736    2.8104","figures":[]},{"title":"The standard error of a mean, by the jackknife","intro":"","code":"x = [3 5 4 6 8 5 7];\njm = jackknife(@mean, x');\nn = numel(x);\nseJack = sqrt((n - 1)/n * sum((jm - mean(jm)).^2))\nstd(x) / sqrt(n)","after":"","output":"seJack =\n\n    0.6494\n\nans =\n\n    0.6494","figures":[]}],"notes":[],"see":["datasample","randsample","prctile"]}]}
