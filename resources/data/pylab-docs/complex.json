cart2sph(x, y, z)","Spherical coordinates of the points."],["[x, y, z] = sph2cart(azimuth, elevation, r)","Cartesian coordinates."]],"inputs":[],"outputs":[],"examples":[{"title":"A point both ways","intro":"","code":"[az, el, r] = cart2sph(1, 1, sqrt(2))\n[x, y, z] = sph2cart(az, el, r)","after":"","output":"az =\n\n    0.7854\n\nel =\n\n    0.7854\n\nr =\n\n     2\n\nx =\n\n    1.0000\n\ny =\n\n     1\n\nz =\n\n    1.4142","figures":[]}],"notes":[],"see":["cart2pol"]}]}
