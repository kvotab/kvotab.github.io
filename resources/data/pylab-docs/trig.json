"Helvetica","margin":3.0,"lineWidth":0.5,"lineStyle":"-"},"cmap":{"$ref":"parula"},"children":[{"id":8,"type":"line","visible":true,"displayName":"","clip":true,"bdf":false,"hit":true,"cmenu":null,"x":{"$":"","shape":[1,200],"dt":"f4"},"y":{"$":"","shape":[1,200],"dt":"f4"},"z":null,"color":[0.0,0.447,0.741],"lineStyle":"-","lineWidth":0.5,"marker":"none","markerSize":6.0,"mfc":"none","mec":"auto"}],"xtickformat":null,"ytickformat":null,"ztickformat":null,"ztickrot":0.0,"polar":null,"texts":[],"yy":null,"units":"normalized","fontUnits":"points","parent":null,"bdf":false,"hit":true,"cmenu":null}],"legends":[],"colorbars":[],"annotations":[],"sgtitle":null,"cmap":{"$ref":"parula"},"menuBar":"figure","toolBar":"auto","pointer":"arrow","resize":true,"dialog":false,"placed":false,"closeDefault":true,"flags":{"wbdf":false,"wbuf":false,"wbmf":false,"scroll":false,"kpf":false,"krf":false,"wkpf":false,"wkrf":false,"bdf":false,"size":false,"resize":false},"cmenu":null,"menus":[],"toolbars":[],"controls":[],"cmenus":[]}]}],"notes":[],"see":["sin","cos","tan","secd","asec"]},{"names":["asin","acos","atan"],"summary":"The inverse sine, cosine and tangent, in radians.","body":["`asin` gives angles from -pi/2 to pi/2, `acos` from 0 to pi, `atan` from -pi/2 to pi/2. Outside [-1, 1] the inverse sine and cosine are complex. For the angle of a point (x, y) in all four quadrants, use `atan2`."],"syntax":[["y = asin(x)","The angle whose sine is `x`."],["y = acos(x)","The angle whose cosine is `x`."],["y = atan(x)","The angle whose tangent is `x`."]],"inputs":[],"outputs":[],"examples":[{"title":"Back to the angles","intro":"","code":"asin(0.5)\nacos([1 0 -1])\natan(1) * 4","after":"","output":"ans =\n\n    0.5236\n\nans =\n\n         0    1.5708    3.1416\n\nans =\n\n    3.1416","figures":[]},{"title":"Outside [-1, 1]","intro":"","code":"asin(2)","after":"","output":"ans =\n\n   1.5708 - 1.3170i","figures":[]}],"notes":[],"see":["sin","atan2","asind"]},{"names":["atan2","atan2d"],"summary":"The angle of the point (x, y): in radians between -pi and pi, or in degrees between -180 and 180.","body":["Unlike `atan(y/x)`, which cannot tell (1, 1) from (-1, -1), `atan2(y, x)` uses the signs of both to give the angle in the right quadrant. Note the order: `y` first."],"syntax":[["theta = atan2(y, x)","In radians."],["theta = atan2d(y, x)","In degrees."]],"inputs":[],"outputs":[],"examples":[{"title":"The four quadrants","intro":"","code":"x = [1 -1 -1 1];\ny = [1 1 -1 -1];\natan2d(y, x)\natand(y ./ x)","after":"","output":"ans =\n\n    45   135  -135   -45\n\nans =\n\n    45   -45    45   -45","figures":[]},{"title":"The direction of a vector, in radians","intro":"","code":"atan2(3, -4)","after":"","output":"ans =\n\n    2.4981","figures":[]}],"notes":[],"see":["atan","angle","cart2pol"]},{"names":["asec","acsc","acot"],"summary":"The inverse secant, cosecant and cotangent, in radians.","body":["`asec(x)` is `acos(1./x)`, `acsc(x)` is `asin(1./x)` and `acot(x)` is `atan(1./x)`."],"syntax":[["y = asec(x)","The angle whose secant is `x`."],["y = acsc(x)","The angle whose cosecant is `x`."],["y = acot(x)","The angle whose cotangent is `x`."]],"inputs":[],"outputs":[],"examples":[{"title":"Inverses of known values","intro":"","code":"asec(2)\nacsc(2)\nacot(1)","after":"","output":"ans =\n\n    1.0472\n\nans =\n\n    0.5236\n\nans =\n\n    0.7854","figures":[]}],"notes":[],"see":["sec","acos","asecd"]},{"names":["sinh","cosh","tanh"],"summary":"The hyperbolic sine, cosine and tangent.","body":["`sinh(x) = (e^x - e^-x)/2`, `cosh(x) = (e^x + e^-x)/2` and `tanh = sinh/cosh`. A hanging chain takes the shape of `cosh`, and `tanh` rises smoothly from -1 to 1, a common smooth step."],"syntax":[["y = sinh(x)","The hyperbolic sine."],["y = cosh(x)","The hyperbolic cosine."],["y = tanh(x)","The hyperbolic tangent."]],"inputs":[],"outputs":[],"examples":[{"title":"The identity cosh^2 - sinh^2 = 1","intro":"","code":"x = [0 0.5 2];\ncosh(x).^2 - sinh(x).^2","after":"","output":"ans =\n\n    1.0000    1.0000    1.0000","figures":[]},{"title":"The three curves","intro":"","code":"x = linspace(-2, 2, 200);\nplot(x, sinh(x), x, cosh(x), x, tanh(x))\nlegend('sinh', 'cosh', 'tanh', 'Location', 'north')\ngrid on","after":"","output":"","figures":[{"id":1,"type":"figure","number":1,"name":"","numberTitle":true,"width":560.0,"height":420.0,"color":[0.94,0.94,0.94],"visible":true,"version":7,"windowStyle":"normal","axes":[{"id":2,"type":"axes","kind":"cartesian","geo":false,"position":[0.13,0.11,0.775,0.815],"xlim":[-2.0,2.0],"ylim":[-4.0,4.0],"zlim":[0.0,1.0],"xlimMode":"auto","ylimMode":"auto","zlimMode":"auto","clim":[0.0,1.0],"tight":{"X":false,"Y":false,"Z":false},"xscale":"linear","yscale":"linear","zscale":"linear","xdir":"normal","ydir":"normal","zdir":"normal","xgrid":true,"ygrid":true,"zgrid":true,"xminorgrid":false,"yminorgrid":false,"zminorgrid":false,"box":true,"color":[1.0,1.0,1.0],"xcolor":[0.15,0.15,0.15],"ycolor":[0.15,0.15,0.15],"zcolor":[0.15,0.15,0.15],"gridColor":[0.15,0.15,0.15],"gridAlpha":0.15,"gridLineStyle":"-","fontSize":10.0,"lineWidth":0.5,"tickDir":"in","view":[0.0,90.0],"camTarget":null,"camUp":null,"xkind":null,"ykind":null,"zkind":null,"xtick":null,"ytick":null,"ztick":null,"xticklabel":null,"yticklabel":null,"zticklabel":null,"xtickrot":0.0,"ytickrot":0.0,"xaxisLocation":"bottom","yaxisLocation":"left","dar":[1.0,1.0,1.0],"darMode":"auto","pbar":[1.0,1.0,1.0],"pbarMode":"auto","camZoom":1.0,"visible":true,"layer":"bottom","fontName":"Helvetica","fontWeight":"normal","tickLabelInterpreter":"tex","tickLength":[0.01,0.025],"xminortick":false,"yminortick":false,"zminortick":false,"minorGridAlpha":0.25,"minorGridLineStyle":":","titleSize":1.1,"labelSize":1.1,"title":{"id":3,"string":"","fontSize":10.0,"fontUnits":"points","fontWeight":"bold","fontAngle":"normal","color":[0.0,0.0,0.0],"rotation":0.0,"interpreter":"tex","visible":true,"halign":"left","valign":"middle","position":[0.0,0.0,0.0],"units":"data","backgro