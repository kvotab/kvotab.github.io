{"slug":"trig","pages":[{"names":["sec","csc","cot"],"summary":"The secant, cosecant and cotangent of angles in radians: 1/cos, 1/sin and 1/tan.","body":["Element by element. Where the cosine, sine or tangent is zero they are infinite (or, because pi is not exact, very large)."],"syntax":[["y = sec(x)","1./cos(x)."],["y = csc(x)","1./sin(x)."],["y = cot(x)","1./tan(x)."]],"inputs":[],"outputs":[],"examples":[{"title":"Some values","intro":"","code":"x = [pi/3 pi/4 pi/6];\n[sec(x); csc(x); cot(x)]","after":"","output":"ans =\n\n    2.0000    1.4142    1.1547\n    1.1547    1.4142    2.0000\n    0.5774    1.0000    1.7321","figures":[]},{"title":"The secant's curve, between its poles","intro":"","code":"x = linspace(-1.4, 1.4, 200);\nplot(x, sec(x))\ngrid on","after":"","output":"","figures":[{"id":1,"type":"figure","number":1,"name":"","numberTitle":true,"width":560.0,"height":420.0,"color":[0.94,0.94,0.94],"visible":true,"version":5,"windowStyle":"normal","axes":[{"id":2,"type":"axes","kind":"cartesian","geo":false,"position":[0.13,0.11,0.775,0.815],"xlim":[-1.5,1.5],"ylim":[1.0,6.0],"zlim":[0.0,1.0],"xlimMode":"auto","ylimMode":"auto","zlimMode":"auto","clim":[0.0,1.0],"tight":{"X":false,"Y":false,"Z":false},"xscale":"linear","yscale":"linear","zscale":"linear","xdir":"normal","ydir":"normal","zdir":"normal","xgrid":true,"ygrid":true,"zgrid":true,"xminorgrid":false,"yminorgrid":false,"zminorgrid":false,"box":true,"color":[1.0,1.0,1.0],"xcolor":[0.15,0.15,0.15],"ycolor":[0.15,0.15,0.15],"zcolor":[0.15,0.15,0.15],"gridColor":[0.15,0.15,0.15],"gridAlpha":0.15,"gridLineStyle":"-","fontSize":10.0,"lineWidth":0.5,"tickDir":"in","view":[0.0,90.0],"camTarget":null,"camUp":null,"xkind":null,"ykind":null,"zkind":null,"xtick":null,"ytick":null,"ztick":null,"xticklabel":null,"yticklabel":null,"zticklabel":null,"xtickrot":0.0,"ytickrot":0.0,"xaxisLocation":"bottom","yaxisLocation":"left","dar":[1.0,1.0,1.0],"darMode":"auto","pbar":[1.0,1.0,1.0],"pbarMode":"auto","camZoom":1.0,"