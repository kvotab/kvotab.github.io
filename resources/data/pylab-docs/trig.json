ape":[1,200],"dt":"f4"},"y":{"$":"","shape":[1,200],"dt":"f4"},"z":null,"color":[0.85,0.325,0.098],"lineStyle":"-","lineWidth":0.5,"marker":"none","markerSize":6.0,"mfc":"none","mec":"auto"},{"id":10,"type":"line","visible":true,"displayName":"tanh","clip":true,"bdf":false,"hit":true,"cmenu":null,"x":{"$":"","shape":[1,200],"dt":"f4"},"y":{"$":"","shape":[1,200],"dt":"f4"},"z":null,"color":[0.929,0.694,0.125],"lineStyle":"-","lineWidth":0.5,"marker":"none","markerSize":6.0,"mfc":"none","mec":"auto"}],"xtickformat":null,"ytickformat":null,"ztickformat":null,"ztickrot":0.0,"polar":null,"texts":[],"yy":null,"units":"normalized","fontUnits":"points","parent":null,"bdf":false,"hit":true,"cmenu":null}],"legends":[{"id":11,"axes":2,"location":"north","orientation":"vertical","box":true,"fontSize":9.0,"visible":true,"textColor":[0.0,0.0,0.0],"color":[1.0,1.0,1.0],"edgeColor":[0.15,0.15,0.15],"numColumns":1,"title":"","entries":[{"id":8,"name":"sinh","type":"line","color":[0.0,0.447,0.741],"lineStyle":"-","lineWidth":0.5,"marker":"none","markerSize":6.0,"markerFaceColor":"none","markerEdgeColor":"auto"},{"id":9,"name":"cosh","type":"line","color":[0.85,0.325,0.098],"lineStyle":"-","lineWidth":0.5,"marker":"none","markerSize":6.0,"markerFaceColor":"none","markerEdgeColor":"auto"},{"id":10,"name":"tanh","type":"line","color":[0.929,0.694,0.125],"lineStyle":"-","lineWidth":0.5,"marker":"none","markerSize":6.0,"markerFaceColor":"none","markerEdgeColor":"auto"}],"interpreter":"tex"}],"colorbars":[],"annotations":[],"sgtitle":null,"cmap":{"$ref":"parula"},"menuBar":"figure","toolBar":"auto","pointer":"arrow","resize":true,"dialog":false,"placed":false,"closeDefault":true,"flags":{"wbdf":false,"wbuf":false,"wbmf":false,"scroll":false,"kpf":false,"krf":false,"wkpf":false,"wkrf":false,"bdf":false,"size":false,"resize":false},"cmenu":null,"menus":[],"toolbars":[],"controls":[],"cmenus":[]}]}],"notes":[],"see":["asinh","exp","sech"]},{"names":["sech","csch","coth"],"summary":"The hyperbolic secant, cosecant and cotangent: 1/cosh, 1/sinh and 1/tanh.","body":["`sech` is a bell-shaped curve with its peak 1 at 0; `csch` and `coth` are infinite at 0."],"syntax":[["y = sech(x)","1./cosh(x)."],["y = csch(x)","1./sinh(x)."],["y = coth(x)","1./tanh(x)."]],"inputs":[],"outputs":[],"examples":[{"title":"Some values","intro":"","code":"x = [0.5 1 2];\n[sech(x); csch(x); coth(x)]","after":"","output":"ans =\n\n    0.8868    0.6481    0.2658\n    1.9190    0.8509    0.2757\n    2.1640    1.3130    1.0373","figures":[]}],"notes":[],"see":["cosh","asech"]},{"names":["asinh","acosh","atanh"],"summary":"The inverse hyperbolic sine, cosine and tangent.","body":["`asinh(x) = log(x + sqrt(x^2 + 1))`, defined for every real number; `acosh` is real for `x >= 1` and `atanh` for -1 < x < 1, complex elsewhere."],"syntax":[["y = asinh(x)","The inverse hyperbolic sine."],["y = acosh(x)","The inverse hyperbolic cosine."],["y = atanh(x)","The inverse hyperbolic tangent."]],"inputs":[],"outputs":[],"examples":[{"title":"Back again","intro":"","code":"asinh(sinh(1.5))\nacosh([1 2 10])\natanh(0.5)","after":"","output":"ans =\n\n    1.5000\n\nans =\n\n         0    1.3170    2.9932\n\nans =\n\n    0.5493","figures":[]}],"notes":[],"see":["sinh","log"]},{"names":["asech","acsch","acoth"],"summary":"The inverse hyperbolic secant, cosecant and cotangent.","body":["`asech(x)` is `acosh(1./x)`, `acsch(x)` is `asinh(1./x)` and `acoth(x)` is `atanh(1./x)`."],"syntax":[["y = asech(x)","The inverse hyperbolic secant."],["y = acsch(x)","The inverse hyperbolic cosecant."],["y = acoth(x)","The inverse hyperbolic cotangent."]],"inputs":[],"outputs":[],"examples":[{"title":"Inverses of the hyperbolic functions","intro":"","code":"asech(sech(0.7))\nacsch(2)\nacoth(2)","after":"","output":"ans =\n\n    0.7000\n\nans =\n\n    0.4812\n\nans =\n\n    0.5493","figures":[]}],"notes":[],"see":["sech","acosh"]},{"names":["sind","cosd","tand","secd","cscd","cotd"],"summary":"The trigonometric functions of angles in degrees.","body":["They give exact results where the values are exact: `sind(180)` is exactly 0 and `cosd(90)` exactly 0, while `sin(pi)` is about 1.2e-16 because `pi` is not exact."],"syntax":[["y = sind(x)","The sine of `x` degrees."],["y = cosd(x)","The cosine."],["y = tand(x)","The tangent."],["y = secd(x)","The secant."],["y = cscd(x)","The cosecant."],["y = cotd(x)","The cotangent."]],"inputs":[],"outputs":[],"examples":[{"title":"Exact zeros","intro":"","code":"sind(180)\nsin(pi)\ncosd([0 60 90 180])","after":"","output":"ans =\n\n     0\n\nans =\n\n   1.2246e-16\n\nans =\n\n    1.0000    0.5000         0   -1.0000","figures":[]},{"title":"A table of angles","intro":"","code":"d = [0 30 45 60];\n[sind(d); cosd(d); tand(d)]","after":"","output":"ans =\n\n         0    0.5000    0.7071    0.8660\n    1.0000    0.8660    0.7071    0.5000\n         0    0.5774    1.0000    1.7321","figures":[]}],"notes":[],"see":["sin","deg2rad","asind"]},{"names":["asind","acosd","atand","asecd","acscd","acotd"],"summary":"The inverse trigonometric functions, in degrees.","body":["The same as `asin`, `acos` and the rest, with the angle given in degrees."],"syntax":[["y = asind(x)","The angle in degrees whose sine is `x`."],["y = acosd(x)","Whose cosine is `x`."],["y = atand(x)","Whose tangent is `x`."],["y = asecd(x)","Whose secant is `x`."],["y = acscd(x)","Whose cosecant is `x`."],["y = acotd(x)","Whose cotangent is `x`."]],"inputs":[],"outputs":[],"examples":[{"title":"Angles in degrees","intro":"","code":"asind(0.5)\nacosd([1 0.5 0])\natand(1)\nasecd(2)","after":"","output":"ans =\n\n   30.0000\n\nans =\n\n         0   60.0000   90.0000\n\nans =\n\n    45\n\nans =\n\n   60.0000","figures":[]}],"notes":[],"see":["sind","atan2d","asin"]},{"names":["sinpi","cospi"],"summary":"sin(pi*x) and cos(pi*x), exact at the integers and half-integers.","body":["`sinpi(x)` is exactly 0 at the integers and `cospi(x)` exactly 0 at the half-integers, where `sin(pi*x)` and `cos(pi*x)` leave round-off."],"syntax":[["y = sinpi(x)","sin(pi*x)."],["y = cospi(x)","cos(pi*x)."]],"inputs":[],"outputs":[],"examples":[{"title":"Exact zeros","intro":"","code":"sinpi([0 1 2 0.5])\nsin(pi*[0 1 2 0.5])\ncospi(0.5)\ncos(pi/2)","after":"","output":"ans =\n\n     0     0     0     1\n\nans =\n\n         0    0.0000   -0.0000    1.0000\n\nans =\n\n     0\n\nans =\n\n   6.1232e-17","figures":[]}],"notes":[],"see":["sin","sind"]},{"names":["deg2rad","rad2deg"],"summary":"Degrees to radians, and radians to degrees.","body":["`deg2rad(d)` is `d*pi/180` and `rad2deg(r)` is `r*180/pi`."],"syntax":[["r = deg2rad(d)","Degrees as radians."],["d = rad2deg(r)","Radians as degrees."]],"inputs":[],"outputs":[],"examples":[{"title":"Both ways","intro":"","code":"deg2rad([90 180 360])\nrad2deg(pi/4)","after":"","output":"ans =\n\n    1.5708    3.1416    6.2832\n\nans =\n\n    45","figures":[]}],"notes":[],"see":["sind","cosd"]}]}
