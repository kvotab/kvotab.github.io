<THERMO>
# CHEMKIN thermodynamic data base (SAND87-8215B, 1990), coefficients a1..a7 of
# the lower temperature range. For each row the Gibbs energy DG<name> (cal/mol)
# is available in the equations and rate expressions:
#   H/RT = a1 + a2 T/2 + a3 T^2/3 + a4 T^3/4 + a5 T^4/5 + a6/T
#   S/R  = a1 ln T + a2 T + a3 T^2/2 + a4 T^3/3 + a5 T^4/4 + a7
H     0.02500000E+02  0.00000000E+00  0.00000000E+00  0.00000000E+00  0.00000000E+00  0.02547162E+06 -0.04601176E+01
H2    0.03298124E+02  0.08249441E-02 -0.08143015E-05 -0.09475434E-09  0.04134872E-11 -0.10125209E+04 -0.03294094E+02
H2O   0.03386842E+02  0.03474982E-01 -0.06354696E-04  0.06968581E-07 -0.02506588E-10 -0.03020811E+06  0.02590232E+02
H2O2  0.03388753E+02  0.06569226E-01 -0.14850125E-06 -0.04625805E-07  0.02471514E-10 -0.01766314E+06  0.06785363E+02
HO2   0.02979963E+02  0.04996697E-01 -0.03790997E-04  0.02354192E-07 -0.08089024E-11  0.01762273E+04  0.09222724E+02
NO    0.03376541E+02  0.12530634E-02 -0.03302750E-04  0.05217810E-07 -0.02446262E-10  0.09817961E+05  0.05829590E+02
NO2   0.02670600E+02  0.07838500E-01 -0.08063864E-04  0.06161714E-07 -0.02320150E-10  0.02896290E+05  0.11612071E+02
O     0.02946428E+02 -0.16381665E-02  0.02421031E-04 -0.16028431E-08  0.03890696E-11  0.02914764E+06  0.02963995E+02
O2    0.03212936E+02  0.11274864E-02 -0.05756150E-05  0.13138773E-08 -0.08768554E-11 -0.10052490E+04  0.06034737E+02
OH    0.03637266E+02  0.01850910E-02 -0.16761646E-05  0.02387202E-07 -0.08431442E-11  0.03606781E+05  0.13588605E+01
O3    0.02462608E+02  0.09582781E-01 -0.07087359E-04  0.13633683E-08  0.02969647E-11  0.16061522E+05  0.12141870E+02
HNO3  0.13531850E+01  0.02220024E+00 -0.01978811E-03  0.08773908E-07 -0.16583844E-11 -0.01738562E+06  0.01851868E+03
HNO2  0.02290413E+02  0.14099223E-01 -0.13678717E-04  0.07498780E-07 -0.01876905E-10 -0.10431945E+05  0.13280769E+02
NH3   0.02204351E+02  0.10114765E-01 -0.14652648E-04  0.14472350E-07 -0.05328509E-10 -0.06525488E+05  0.08127138E+02
NH2   0.03432493E+02  0.03299540E-01 -0.06613600E-04  0.08590947E-07 -0.03572046E-10  0.02177227E+06  0.03090110E+02

<INITIAL>
# Evaluated once at t = 0. A name that is a species sets its initial
# concentration; any other name becomes a constant of the run. The equations
# that depend on time only (T, VPP, H2OEQ, ...) may be used here.
VOLUME_CM3   = VOLUME*1.0E6                       # free volume (cm3)
PRESSI_PA    = PRESSI*ATM_PA                      # initial pressure of the dry gas (Pa)
CON          = PRESSI_PA/(RJ*T*1.0E6)             # dry gas concentration (mol/cm3)
O2           = 0.2*PCAIR*CON                      #  (mol/cm3)
N2           = 0.8*PCAIR*CON                      #  (mol/cm3)
AR           = PCAR*CON                           #  (mol/cm3)
H2OALL       = H2OLQDI/(VOLUME_CM3*18)            # all the water present at closure (mol/cm3)
# With H2OPAIR = 0 the state H2O carries all of it; with H2OPAIR = 1 it carries
# the saturated gas phase only and the rest starts as liquid, as FACSIMILE did.
H2O          = H2OPAIR*min(H2OALL, H2OEQ) + (1 - H2OPAIR)*H2OALL   # (mol/cm3)
H2OLIQ       = H2OPAIR*(H2OALL - min(H2OALL, H2OEQ))               # liquid water (mol/cm3)
DENSI        = O2*32 + N2*28 + min(H2O, H2OEQ)*18 + AR*40   # initial gas density (g/cm3)
DOSERI_100EV = DOSERI*100/3600*(6.2415E11/NA)*DENSI          # dose rate, (100 eV cm-3 s-1 per mole)
FE_LOSS_CONV = STEELAREA*FEDENS/(MWFE*VOLUME_CM3*DPY*24*3.6) # convert mm/y -> (mol Fe cm-3 s-1)
FE_RATE_1    = AERCORRAT*FE_LOSS_CONV             # oxic iron loss (mol cm-3 s-1)
FE_RATE_2    = ANCORRAT*FE_LOSS_CONV              # anoxic iron loss (mol cm-3 s-1)
FE_RATE_1_RH = AERCORRATRH*FE_LOSS_CONV           # oxic iron loss below the RH limit (mm/y)
FE_RATE_2_RH = ANCORRATRH*FE_LOSS_CONV            # anoxic iron loss below the RH limit (mm/y)
H2OINPUT_CM3 = H2OINPUTR/(VOLUME_CM3*24*3600*18)  # water release (mol cm-3 s-1)

<EQUATIONS>
# Evaluated, in this order, every time the derivatives are needed. They may use
# t (seconds), the species, the constants and the equations above them.
T        = interp(TPROF, t/YEAR_S) - K0           # temperature (K)
VPP      = interp(VPH2O, T + K0)*1000             # saturation vapour pressure (Pa)
H2OEQ    = VPP/(RJ*T*1.0E6)                       # saturation concentration of water vapour (mol/cm3)
@H2O     = H2OPAIR*H2O + (1 - H2OPAIR)*min(H2O, H2OEQ)   # gas-phase water: the state itself when the pair carries the split, else the part below saturation
RT       = R*T
M        = O2 + N2 + H2O + AR + H2 + NH3          # third-body concentration (mol/cm3)
M2H      = M - H2O - H2
DOSER    = DOSERI_100EV*exp(-LAMBDA*t)            # decaying dose rate
DOSR     = DOSER/M                                # dose rate per mole of gas
# Fall-off parameters of NO + O, NO + OH and NO2 + OH
K0HNO3   = 6.37E+32*T**-5.49*exp(-1183/T)
KINFN    = 2.4E+13
K0HNO2   = 7.2E+22*T**-2.13*exp(185/T)
KINFN2   = 2.0E+12*T**-0.05*exp(363/T)
K0NO2    = 4.7E+24*T**-2.87*exp(-781/T)
KINFN3   = 1.3E+15*T**-0.75
FCNO2    = 0.95 - 1.0E-4*T
FHNO2    = 10**(log10(FCNO2)/(1 + log10(K0NO2*M/KINFN3)**2))
FCHNO3   = 0.725 - 2.5E-4*T
FHNO3    = 10**(log10(FCHNO3)/(1 + log10(K0HNO3*M/KINFN)**2))
# Corrosion switches
H2ORH    = H2O/H2OEQ                              # relative humidity (-)
H2ORHOFF = 1 - step(RHLIM) + step(RHLIM)*exp(-1.0E-8/(ramp(H2ORH - RHLIM) + 5.0E-10))  # 1 above the RH limit, 0 below
c1       = CORR_ON*(FE_RATE_1*H2ORHOFF + FE_RATE_1_RH*(1 - H2ORHOFF))   # oxic iron loss in force (mol cm-3 s-1)
c2       = CORR_ON*(FE_RATE_2*H2ORHOFF + FE_RATE_2_RH*(1 - H2ORHOFF))   # anoxic iron loss in force (mol cm-3 s-1)
f1       = exp(-RAMP_ORDER/(ramp(O2) + RAMP_ORDER/100))                # 1 while oxygen remains, 0 when it is gone
f2       = exp(-RAMP_ORDER/(ramp(H2O) + RAMP_ORDER/100))               # 1 while water remains

<REACTIONS>
# reactants = products, kf = forward rate constant [, kb = backward rate constant | keq = equilibrium constant]
# or          reactants = products, rf = forward rate (absolute, mol cm-3 s-1) [, rb = backward rate]
# A number before a species is its stoichiometric coefficient ("2 OH").
# FACSIMILE's own form "%kf%kb : A + B = C ;" and "=rate : A = ;" is accepted too.
#
# ***** Evaporation and condensation (H2OPAIR = 1 only) *****
# FACSIMILE's own pair, rates and all: condensation first order in the vapour,
# evaporation zeroth order at 1E6*H2OEQ and switched off once the liquid is
# gone. Together they hold H2O at H2OEQ while any liquid remains, which is
# what min(H2O, H2OEQ) asserts directly when H2OPAIR = 0. Both rates are zero
# then, so H2OLIQ never leaves the zero it started at.
H2O = H2OLIQ, rf = H2OPAIR*1.0E6*H2O
H2OLIQ = H2O, rf = H2OPAIR*1.0E6*H2OEQ*exp(-1.0E-14/(ramp(H2OLIQ) + 1.0E-17))
#
# ***** Water release from failed rods *****
= H2O + H2OTOT, rf = H2OINPUT_CM3, rate = RH2OIN                       # switched off by the event below (mol cm-3 s-1)
#
# ***** Steel corrosion *****
3 O2 = , rf = c1/4*f1*f2, rate = ROXID                                 # 4Fe + 2H2O + 3O2 = 4FeOOH: oxygen consumed (mol cm-3 s-1)
2 H2O = , rf = c1/4*f1*f2, rate = ROXIDW                               # 4Fe + 2H2O + 3O2 = 4FeOOH: water consumed (mol cm-3 s-1)
4 H2O = 4 H2, rf = c2/3*(1 - f1)*f2, rate = RANOX                      # 3Fe + 4H2O = Fe3O4 + 4H2 once the oxygen is gone (mol cm-3 s-1)
#
# *******PRIMARY REACTIONS*************************
N2 = N2P + E, kf = GN2P*DOSR*0.9
N2 = NP + E + N, kf = GNP*DOSR
N2 = 2 N, kf = GN*DOSR
N2 = 2 ND2, kf = GND2*DOSR*0.9
N2 = 2 NP2, kf = GNP2*DOSR
N2 = N2S, kf = GN2S*DOSR
O2 = O2P + E, kf = GO2P*DOSR
O2 = OP + E + O, kf = GOP*DOSR
O2 = O2S, kf = GO2S*DOSR
H2O = H2OP + E, kf = GH2OP*DOSR
H2O = H + OH, kf = GH*DOSR
H2O = OH + HP + E, kf = GOH*DOSR
H2O = O + 2 HP + 2 E, kf = GOH2O*DOSR
H2O = O + H2, kf = GH2*DOSR
AR = ARP + E, kf = GARP*DOSR
# AR = ARS, kf=GARP*DOSR
NH3 = NH3P + E, kf = 2 *DOSR
NH3 = NH2P + H + E, kf = 1.6 *DOSR
NH3 = NHP + H2 + E, kf = 0.085 *DOSR
NH3 = NHP + 2 H + E, kf = 0.085 *DOSR
NH3 = NH2 + H, kf = 5.7 *DOSR
NH3 = NH + H2, kf = 0.7 *DOSR
H2O2 = 2 OH, kf = 1.0 *DOSR

# ******N2S REACTIONS*******************************
N2S + N2 = 2 N2, kf = 3.7E-16*NA                                       # K1 = 3.7E-16*NA
N2S + NO = NO + N2, kf = 2.8E-11*NA                                    # K2 = 2.8E-11*NA
N2S + O2 = 2 O + N2, kf = 1.5E-12*NA                                   # K3 = 1.5E-12*NA
N2S + O2 = O2 + N2, kf = 8.1E-13*NA                                    # K4 = 8.1E-13*NA
N2S + N2O = 2 N2 + O, kf = 1.4E-11*NA                                  # K5 = 1.4E-11*NA
N2S + NO2 = NO + O + N2, kf = 1.0E-12*NA                               # K6 = 1.0E-12*NA

# *******O2S, HP, H2OP REACTIONS********************************
O2S + N2 = O2 + N2, kf = 1.0E-12*NA                                    # K7 = 1.0E-12*NA
HP + H2O = H3OP, kf = 1.0E-03*NA                                       # K8 = 1.0E-03*NA
H2OP + H2O = H3OP + OH, kf = 1.7E-09*NA                                # K9 = 1.7E-09*NA
H2OP + O2 = O2P + H2O, kf = 4.3E-10*NA                                 # K10 = 4.3E-10*NA

# ********N3P REACTIONS******************************
N3P + O2 = NOP + N2O, kf = 3.6E-11*NA                                  # K11 = 3.6E-11*NA
N3P + O2 = NO2P + N2, kf = 1.5E-11*NA                                  # K12 = 1.5E-11*NA
N3P + NO = NOP + N + N2, kf = 1.4E-10*NA                               # K13 = 1.4E-10*NA
N3P + NO2 = NOP + NO + N2, kf = 7.0E-11*NA                             # K14 = 7.0E-11*NA
N3P + NO2 = NO2P + N + N2, kf = 7.0E-11*NA                             # K15 = 7.0E-11*NA
N3P + N2O = NOP + 2 N2, kf = 5.0E-11*NA                                # K16 = 5.0E-11*NA
N3P + E = N + N2, kf = 2.0E-05*NA                                      # K17 = 2.0E-05*NA
N3P + NO2M = N + N2 + NO2, kf = 2.0E-06*NA                             # K18 = 2.0E-06*NA

# ********OP REACTIONS******************************
OP + N2 = NOP + N, kf = 1.2E-12*NA                                     # K19 = 1.2E-12*NA
OP + NO = NOP + O, kf = 1.7E-12*NA                                     # K20 = 1.7E-12*NA
OP + O2 = O2P + O, kf = 1.9E-11*NA                                     # K21 = 1.9E-11*NA
OP + NO2 = NO2P + O, kf = 1.6E-09*NA                                   # K22 = 1.6E-09*NA
