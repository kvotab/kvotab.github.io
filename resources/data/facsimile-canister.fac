HO2 + OH = H2O + O2, kf = 2.9E+13*exp(250/T), keq = exp(-(-DGHO2-DGOH+DGO2+DGH2O)/RT) # % K116  = 2.9D+13*EXP(250/T)            % KR116 = K116/EXP(-DG/(R*T))
HO2 + HO2 = H2O2 + O2, kf = 1.9E+12*exp(-775/T), keq = exp(-(-2*DGHO2+DGH2O2+DGO2)/RT) # % K171  = 1.90D+12*EXP(-775/T)          % KR171 = K171/EXP(-DG/(R*T))
# H2O2 = 2OH, kf=0.05*M
2 OH = H2O2, kf = 6.7E-33*NA*NA*(T/298)**-1.18*exp(-(17.88E+03/RJ)/T)*M, keq = exp(-(-2*DGOH+DGH2O2)/RT)/(RV*T) # K120 = NA*NA*6.7E-33*(T/298)@-1.18*EXP(-17.88E3/8.314/T) % KR120 = K120*RV*T/EXP(-DG/(R*T))
H2O2 + H = HO2 + H2, kf = 1.7E+12*exp(-1890/T), keq = exp(-(-DGH-DGH2O2+DGH2+DGHO2)/RT) # % K172  = 1.7D+12*EXP(-1890/T)          % KR172 = K172/EXP(-DG/(R*T))
H2O2 + OH = H2O + HO2, kf = 1.8E+12*exp(-168/T), keq = exp(-(-DGH2O2-DGOH+DGH2O+DGHO2)/RT) # % K121  = 1.8D+12*EXP(-168/T)           % KR121 = K121/EXP(-DG/(R*T))
O3 = O2 + O, kf = 2.5E+14*exp(-11430.0/T)*M, keq = exp(-(-DGO3+DGO2+DGO)/RT)/(RV*T) # % K112  = 2.5E14*EXP(-11430.0/T)        % KR112 = K112*RV*T/EXP(-DG/(R*T))
O3 + O = 2 O2, kf = 5.2E+12*exp(-2090.0/T), keq = exp(-(-DGO3-DGO+2*DGO2)/RT) # % K114  = 5.2E+12*EXP(-2090.0/T)        % KR114 = K114/EXP(-DG/(R*T))
O3 + OH = HO2 + O2, kf = 7.8E+11*exp(-960.0/T), keq = exp(-(-DGO3-DGOH+DGHO2+DGO2)/RT) # % K117  = 7.8E+11*EXP(-960.0/T)         % KR117 = K117/EXP(-DG/(R*T))
O3 + HO2 = OH + 2 O2, kf = 6.0E+10*exp(-1263.0/T), keq = exp(-(-DGO3-DGHO2+2*DGO2+DGOH)/RT)/(RV*T) # % K118 = 6.0E+10*EXP(-1263.0/T)        % KR118 = K118*RV*T/EXP(-DG/(R*T))

# ***N CHEMISTRY ***************************************
N + NO2 = N2O + O, kf = 2.4E-12*NA                                     # K124 = 2.4E-12*NA
N + NO2 = 2 NO, kf = 6.0E-13*NA                                        # K125 = 6.0E-13*NA
2 N = N2, kf = 3.9E-33*NA*NA*M                                         # K126 = 3.9E-33*NA*NA
N + OH = NO + H, kf = 4.8E-11*NA                                       # K127 = 4.8E-11*NA
N + O = NO, kf = 3.9E-32*NA*NA*M                                       # K128 = 3.9E-32*NA*NA
N + O2 = NO + O, kf = 7.8E-16*NA                                       # K129 = 7.8E-16*NA
N + O3 = NO + O2, kf = 5.0E-16*NA                                      # K130 = 5.0E-16*NA
N + NO = N2 + O, kf = 3.1E-11*NA                                       # K131 = 3.1E-11*NA
ND2 + NO = N2 + O, kf = 6.3E-11*NA                                     # K132A = 6.3E-11*NA
NP2 + NO = N2 + O, kf = 3.0E-11*NA                                     # K132B = 3.0E-11*NA
ND2 + O2 = NO + O, kf = 6.8E-12*NA                                     # K133A = 6.8E-12*NA
NP2 + O2 = NO + O, kf = 2.0E-12*NA                                     # K133B = 2.0E-12*NA
N + N2O = NO + N2, kf = 2.6E-12*NA                                     # K134 = 2.6E-12*NA
ND2 + N2O = NO + N2, kf = 2.6E-12*NA                                   # K134A = 2.6E-12*NA
# N + NO2 = N2O + O ,kf=1.5E-12*NA        # K135 = 1.5E-12*NA
# N + NO2 = 2NO ,kf=1.5E-12*NA        # K136 = 1.5E-12*NA
ND2 + NO2 = N2O + O, kf = 1.5E-12*NA                                   # K135A = 1.5E-12*NA
ND2 + NO2 = 2 NO, kf = 1.5E-12*NA                                      # K136A = 1.5E-12*NA
NP2 + NO2 = N2O + O, kf = 1.5E-12*NA                                   # K135B = 1.5E-12*NA
NP2 + NO2 = 2 NO, kf = 1.5E-12*NA                                      # K136B = 1.5E-12*NA
N + H2 = NH + H, kf = 4.65E-10*NA*exp(-(138.0E+03/RJ)/T)               # 4.65E-10*NA*EXP(-138.0E3/8.314/T)

# *******NO CHEMISTRY***********************
NO + HO2 = NO2 + OH, kf = 7.0E-12*NA*2                                 # K137 = 7.0E-12*NA *2
NO + O = NO2, kf = K0NO2*FHNO2/(1+K0NO2 *M/KINFN3)*2 *M, keq = RV*T*exp(-(-DGNO-DGO+DGNO2)/RT) # kf=K138 = K0NO2*FHNO2/(1.0+ K0NO2*M/KINFN3) *2 % kb=K138/(RV*T*EXP(-DG/(R*T))) *2
NO + OH = HNO2, kf = K0HNO2 /(1+K0HNO2*M/KINFN2)*0.5*M, keq = RV*T*exp(-((-DGNO-DGOH+DGHNO2)*1.1)/RT) # K139 = K0HNO2/(1.0+ K0HNO2*M/KINFN2) *0.5 % KR139   = K139/(RV*T*EXP(-DG*1.1/(R*T))) *0.5
# HNO2 + HNO2 = NO + NO2 + H2O, kf=NA*1.7E-11*EXP(-3580/8.314/T)
NO + H = HNO, kf = 3.4E-32*NA*NA*M                                     # K140 = 3.4E-32*NA*NA
NO + NO3 = 2 NO2, kf = 2.0E-11*NA                                      # K141 = 2.0E-11*NA
NO + O3 = NO2 + O2, kf = 4.6E-14*NA                                    # K142 = 4.6E-14*NA
2 NO + O2 = 2 NO2, kf = 1.4E-38*NA*NA                                  # K143 = 1.4E-38*NA*NA
NO + NH = N2O + H, kf = 1.3E-12*NA                                     # K144 = 1.3E-12*NA

# ********NO2 CHEMISTRY**********************
NO2 + H = OH + NO, kf = 8.0E-11*NA                                     # K145 = 8.0E-11*NA
NO2 + O = NO3, kf = 5.0E-32*NA*NA*0.5*M                                # K146 = 5.0E-32*NA*NA *0.5
NO2 + O = NO + O2, kf = 9.3E-12*NA*2                                   # K147 = 9.3E-12*NA *2
NO2 + OH = HNO3, kf = K0HNO3*FHNO3/(1+K0HNO3*M/KINFN)*2*M, keq = RV*T*exp(-(-DGNO2-DGOH+DGHNO3)/RT) # kf=K148 = K0HNO3*FHNO3/(1.0+ K0HNO3*M/KINFN) *2 kb=K148/(RV*T*EXP(-DG/(R*T))) *2
NO2 + OH = HO2 + NO, kf = 1.8E+13*exp(-3360/T)                         # 1.8E13*EXP(-3360/T)
NO2 + HO2 = HO2NO2, kf = 7.1E-32*NA*NA*M, kb = 2.5E+02                 # kf=K149 = 7.1E-32*NA*NA kb=K150 = 2.5E+02
NO2 + O3 = NO3 + O2, kf = 1.7E-16*NA                                   # K151 = 1.7E-16*NA
NO2 + NO3 = N2O5, kf = 1.1E-12*NA                                      # K152 = 1.1E-12*NA
# NO2 + H2O2 = NO + HO2 + OH, kf=1E-18*NA              # 1E-18*NA

# ******NO3 CHEMISTRY*****************************
NO3 + O = O2 + NO2, kf = 1.0E-11*NA                                    # K153 = 1.0E-11*NA
2 NO3 = 2 NO2 + O2, kf = 1.2E-15*NA                                    # K154 = 1.2E-15*NA

# ****N2O5 CHEMISTRY******************************
N2O5 = NO2 + NO3, kf = 73.0                                            # K155 = 73.0
N2O5 + H2O = 2 HNO3, kf = 5.0E-21*NA                                   # K156 = 5.0E-21*NA

# *****N2O CHEMISTRY**********************
N2O + OH = HNO + NO, kf = 3.8E-17*NA                                   # K157 = 3.8E-17*NA

# *****HNO CHEMISTRY*********************
HNO + H = H2 + NO, kf = 1.0E-11*NA                                     # K158 = 1.0E-11*NA
HNO + OH = H2O + NO, kf = 7.0E-11*NA*2                                 # K160 = 7.0E-11*NA + K159 = 7.0E-11*NA
NH + O2 = HNO + O, kf = 2.3E-13*NA                                     # K161 = 2.3E-13*NA

# ****HNO2 AND HNO3 CHEMISTRY*********************
OH + HNO2 = NO2 + H2O, kf = 6.6E-12*NA*2                               # K162 = 6.6E-12*NA *2
OH + HNO3 = NO3 + H2O, kf = 8.6E-14*NA                                 # K163 = 8.6E-14*NA

# *****NP2 and ND2 DE_EXCITATION*****
ND2 + N2 = N + N2, kf = 2.4E-14*NA                                     # K164 = 2.4E-14*NA
NP2 + N2 = N + N2, kf = 2.0E-18*NA                                     # K165 = 2.0E-18*NA
ND2 = N, kf = 2.4E-14*NA*M                                             # K164 = 2.4E-14*NA
NP2 = N, kf = 2.0E-18*NA*M                                             # K165 = 2.0E-18*NA

# No corrosion

<EVENTS>
# expression, NAME = value [, NAME = value ...]: when the expression crosses
# zero from below, the named settings or constants are changed, the run
# constants are recomputed and the integration continues.
H2OTOT*VOLUME_CM3*18 - H2OFINAL, H2OINPUTR = 0    # stop the release when H2OFINAL grams have been added

<TIMES h>
# Times, in hours, at which the run is also reported -- the Table tab, the CSV
# and the Excel file will give them when "at the model's output times" is
# chosen, interpolated between the solver's own steps. This is what
# FACSIMILE's WHENEVER lists did; the first line is the one the original
# printed at, and the second covers the whole run.
1 2 3 4 4.2 4.5 4.8 5 6 7 8 9 10 11 15
1.0E-4 .. 4.383E6 log 200

<OUTPUTS>
# Derived quantities for the table and the charts (the equations are available too).
TIMH     = t/3600                                 # time (h)
TIMY     = t/YEAR_S                               # time (years)
TMP      = T + K0                                 # temperature (°C)
H2OGAS   = H2O                                    # water vapour (mol/cm3)
# Liquid water, whichever model is in use: the H2OLIQ species when the pair
# carries it, and the part of the state above saturation when it does not.
# Exactly one of the two terms is non-zero, so the sum needs no switch.
H2OLQD   = H2OLIQ + (state(H2O) - H2O)            # liquid water (mol/cm3); state() is the raw state variable
# Gas density with the molar masses of the FACSIMILE model (NO2 44, HNO2 45)
DENS     = 28*N2 + 18*H2O + 32*O2 + 2*H2 + 30*NO + 44*NO2 + 62*NO3 + 48*O3 + 31*HNO + 44*N2O + 63*HNO3 + 45*HNO2 + 34*H2O2 + 108*N2O5 + 17*NH3 + 40*AR   # (g/cm3)
MW       = DENS/(N2 + H2O + O2 + H2 + NO + NO2 + NO3 + O3 + HNO + N2O + HNO3 + HNO2 + H2O2 + N2O5 + NH3 + AR)   # mean molar mass (g/mol)
XO2      = O2*32/DENS*1E6                         # mass fractions in ppm (ppm)
XN2      = N2*28/DENS*1E6                         # mass fractions in ppm (ppm)
XH2O     = H2O*18/DENS*1E6                        # mass fractions in ppm (ppm)
XH2      = H2*2/DENS*1E6                          # mass fractions in ppm (ppm)
XNO      = NO*30/DENS*1E6                         # mass fractions in ppm (ppm)
XNO2     = NO2*46/DENS*1E6                        # mass fractions in ppm (ppm)
XNO3     = NO3*62/DENS*1E6                        # mass fractions in ppm (ppm)
XN2O     = N2O*44/DENS*1E6                        # mass fractions in ppm (ppm)
XN2O5    = N2O5*108/DENS*1E6                      # mass fractions in ppm (ppm)
XHNO3    = HNO3*63/DENS*1E6                       # mass fractions in ppm (ppm)
XHNO2    = HNO2*47/DENS*1E6                       # mass fractions in ppm (ppm)
XH2O2    = H2O2*34/DENS*1E6                       # mass fractions in ppm (ppm)
XNH3     = NH3*17/DENS*1E6                        # mass fractions in ppm (ppm)
PRESS    = (HP + N2 + H2O + O2 + N + H + OH + H2 + O + NO + NO2 + NO3 + O3 + HO2 + HNO + N2O + HNO3 + HNO2 + HO2NO2 + H2O2 + N2O5 + N2P + N3P + NP + NOP + NO2P + NO2M + NO3M + H2OP + H3OP + O2P + OP + NOPO2 + N4P + O2PH2O + H3OPH2O + H3OPH2O2 + NOPH2O3 + H2NOP + O2M + E + NH + HN2 + NH2 + NH3 + NH4P + NH3P + NOPH2O + NOPH2O2 + N2S + O2S + H2OPH2O2 + NP2 + ND2 + AR + ARHP + ARP + ARS + HN2P + NH2P + NHP + H2O2P)*1E6*RJ*T   # total gas pressure (Pa)
PRESSP   = PRESS/ATM_PA                           # total gas pressure (atm)
DOSRP    = DOSERI*exp(-LAMBDA*t)                  # dose rate (Gy/h)
DOSES    = DOSERI_100EV/1E6*t                     # accumulated dose (100 eV m-3 per mole); FACSIMILE's DOSES
H2OTOTAL = (state(H2O) + H2OLIQ)*VOLUME_CM3*18    # all water (g)
H2OMASSG = H2O*VOLUME_CM3*18                      # water vapour (g)
H2OMASSL = H2OLQD*VOLUME_CM3*18                   # liquid water (g)
H2OADDED = H2OTOT*VOLUME_CM3*18                   # water released from failed rods (g)
MASSH2OG = VPP/(RJ*T)*18*VOLUME                   # water the gas volume can hold as vapour (g)
O2MOL    = O2*VOLUME_CM3                          # amounts in the canister (mol)
H2MOL    = H2*VOLUME_CM3                          # amounts in the canister (mol)
N2MOL    = N2*VOLUME_CM3                          # amounts in the canister (mol)
NH3MOL   = NH3*VOLUME_CM3                         # amounts in the canister (mol)
HNO3MOL  = HNO3*VOLUME_CM3                        # amounts in the canister (mol)
HNO2MOL  = HNO2*VOLUME_CM3                        # amounts in the canister (mol)
H2O2MOL  = H2O2*VOLUME_CM3                        # amounts in the canister (mol)
H2OMOL   = H2O*VOLUME_CM3                         # water vapour (mol)
CORRAT1  = c1                                     # oxic iron loss in force (mol cm-3 s-1)
CORRAT2  = c2                                     # anoxic iron loss in force (mol cm-3 s-1)
# The two corrosion fluxes, as multiples of the reactions' own net rates
# rather than as a second copy of the rate laws: 3 O2 are consumed and 4 H2
# produced per turn of the respective reaction.
dDUMO2   = 3*ROXID                                # oxygen consumption by corrosion (mol cm-3 s-1)
dDUMH2   = 4*RANOX                                # hydrogen production by corrosion (mol cm-3 s-1)
# The apparent G-value for fixed nitrogen, which the FACSIMILE model computed
# from five dummy variables carrying the derivatives ('HNO3DUM and the rest).
# deriv() reads a species' derivative directly.
GHNO3    = (deriv(HNO3) + deriv(HNO2) + deriv(NO2) + deriv(NO3) + deriv(NO))/DOSER   # apparent G-value for fixed nitrogen (/100 eV)
