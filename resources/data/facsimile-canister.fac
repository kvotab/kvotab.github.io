# ============================================================================
#  Radiolysis and corrosion in the gas of an intact KBS-3 canister
#
#  A FACSIMILE-style description of the model in skbcanister11b/13g/16x.fac
#  (SKB TR-22-15) as ported to Python in skbcanister.py.  Sections start with
#  a line "<NAME>"; "#" starts a comment, and FACSIMILE's "*" comment lines
#  and trailing ";" are accepted too.  Names are case-sensitive.
#
#  Units: time t in seconds, concentrations in mol/cm3, temperature T in K,
#  energies in cal/mol, rate constants in cm3 mol-1 s-1 (bimolecular).
#
#  Differences from the FACSIMILE original (carried over from the Python port):
#   - rate constants are re-evaluated at the current temperature
#   - constants are given with more digits (NA, R, RV, RJ, days per year)
#   - liquid water is not a separate species by default: H2O holds all water
#     and the amount above the saturation concentration H2OEQ is taken to be
#     liquid (the "@H2O" line below). Setting H2OPAIR = 1 restores FACSIMILE's
#     own treatment instead: a separate liquid species H2OLIQ and a fast
#     evaporation/condensation pair between the two. Both give H2O saturated
#     while liquid remains; the pair is far stiffer, which is what the
#     substitution was written to avoid.
#   - the RH and O2/H2O switches use the ramp functions of the latest version
# ============================================================================

<SETTINGS>
DOSERI      = 238.0      # Initial dose rate (Gy/h)
STEELAREA   = 27.8       # Steel surface area (m2)
VOLUME      = 1.2        # Free gas volume (m3)
PRESSI      = 0.03       # Initial gas pressure, dry gas (atm)
PCAIR       = 1.0        # Air fraction of the initial gas (-)
PCAR        = 1 - PCAIR  # Argon fraction of the initial gas (-)
H2OLQDI     = 600        # Water present at closure (g)
H2OPAIR     = 0          # Water model: 0 = one H2O species, the excess over H2OEQ is liquid; 1 = FACSIMILE's evaporation/condensation pair
H2OFINAL    = 600        # Total water released from failed rods (g)
H2OINPUTR   = 0          # Water release rate from failed rods (g/day)
TPROF       = TEMP_PWR   # Temperature profile (table)
CORR_ON     = 1          # Steel corrosion (1 = on, 0 = off)
RHLIM       = 0.6        # Corrosion only above this relative humidity (0 = no limit)
AERCORRAT   = 0.4        # Oxic corrosion rate (mm/y)
ANCORRAT    = 3.0E-3     # Anoxic corrosion rate (mm/y)
AERCORRATRH = 0          # Oxic corrosion rate below the RH limit (mm/y)
ANCORRATRH  = 0          # Anoxic corrosion rate below the RH limit (mm/y)
RAMP_ORDER  = 1.0E-8     # Width of the O2 and H2O depletion switches (mol/cm3)
TEND        = 500        # Simulated time (years)

<CONSTANTS>
K0     = -273.15            # Absolute zero (°C)
NA     = 6.02214076E23      # Avogadro constant (1/mol)
R      = 1.98720425864083   # Gas constant (cal/K/mol)
RV     = 8.2057366080960E-5 # Gas constant (atm cm3/K/mol)
RJ     = 8.31446261815324   # Gas constant (J/K/mol)
FEDENS = 7.85               # Density of iron (g/cm3)
MWFE   = 55.8450            # Molar mass of iron (g/mol)
DPY    = 365.25             # Days per year (day/y)
YEAR_S = DPY*24*3600        # Seconds per year (s/year)
ATM_PA = 1.01E5             # 1 atm in Pa, as used in the FACSIMILE model (Pa/atm)
LAMBDA = 7.33E-10           # Decay constant of the dose rate (1/s)
# G-values: species produced per 100 eV absorbed (Person and Ham 1988,
# after Willis and Boyd 1976). Independent of LET for gases.
GN2P   = 2.15               # N2 = N2P + E (/100 eV)
GNP    = 0.54               # N2 = NP + E + N (/100 eV)
GN     = 0.16               # N2 = 2 N (/100 eV)
GND2   = 0.335              # N2 = 2 ND2 (/100 eV)
GNP2   = 0.0245             # N2 = 2 NP2 (/100 eV)
GN2S   = 0.69               # N2 = N2S (/100 eV)
GO2P   = 0.69               # O2 = O2P + E (/100 eV)
GOP    = 0.41               # O2 = OP + E + O (/100 eV)
GO     = 0.03               # atomic O, declared but used by no reaction (/100 eV)
GO2S   = 0.63               # O2 = O2S (/100 eV)
GH2OP  = 0.85               # H2O = H2OP + E (/100 eV)
GH     = 1.36               # H2O = H + OH (/100 eV)
GOH    = 0.03               # H2O = OH + HP + E (/100 eV)
GOH2O  = 0.095              # H2O = O + 2 HP + 2 E (/100 eV)
GH2    = 0.055              # H2O = O + H2 (/100 eV)
GARP   = 3.8                # AR = ARP + E (/100 eV)

<SPECIES>
# The 62 gas-phase species of the FACSIMILE model, in its order, and the
# book-keeping species H2OTOT (water released from failed rods). Species
# that appear in a reaction but not here are appended automatically.
HP N2 H2O O2 N H OH H2 O NO
NO2 NO3 O3 HO2 HNO N2O HNO3 HNO2 HO2NO2 H2O2
N2O5 N2P N3P NP NOP NO2P NO2M NO3M H2OP H3OP
O2P OP NOPO2 N4P O2PH2O H3OPH2O H3OPH2O2 NOPH2O3 H2NOP O2M
E NH HN2 NH2 NH3 NH4P NH3P NOPH2O NOPH2O2 N2S
O2S H2OPH2O2 NP2 ND2 AR ARHP ARP ARS HN2P NH2P
NHP H2O2P H2OTOT H2OLIQ

